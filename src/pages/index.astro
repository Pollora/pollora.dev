---
import polloraLogo from '../assets/pollora-logo.svg';
import '../styles/global.css';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Pollora — Laravel meets WordPress</title>
	<meta name="description" content="The modern PHP framework that blends Laravel's elegance with WordPress's power. PHP 8 attributes, Blade templates, auto-discovery — zero compromise." />
	<meta property="og:title" content="Pollora — Laravel meets WordPress" />
	<meta property="og:description" content="Modern PHP framework blending Laravel and WordPress. PHP 8 attributes, auto-discovery, Blade templates." />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://pollora.dev" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
</head>

<body class="bg-paper text-ink">

	<!-- ═══ NAV — N1b SaaS three-section ═══ -->
	<nav class="fixed top-0 left-0 right-0 z-[var(--z-sticky)] bg-paper/80 backdrop-blur-xl border-b border-rule">
		<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,1.5rem)] h-16 flex items-center justify-between">
			<a href="/" class="flex items-center gap-2" aria-label="Pollora home">
				<img src={polloraLogo.src} alt="Pollora" class="h-7 w-auto" width="173" height="70" />
			</a>
			<div class="hidden md:flex items-center gap-8 font-[var(--font-body)] text-sm font-medium text-ink-2">
				<a href="/getting-started/installation/" class="hover:text-ink transition-colors duration-[var(--dur-micro)]">Docs</a>
				<a href="#ecosystem" class="hover:text-ink transition-colors duration-[var(--dur-micro)]">Ecosystem</a>
				<a href="#nectar" class="hover:text-ink transition-colors duration-[var(--dur-micro)]">Nectar AI</a>
				<a href="https://github.com/Pollora" target="_blank" rel="noopener" class="hover:text-ink transition-colors duration-[var(--dur-micro)]">GitHub</a>
			</div>
			<a href="/getting-started/installation/" class="hidden md:inline-flex items-center gap-2 px-5 py-2 rounded-[var(--radius-pill)] bg-ink text-paper text-sm font-semibold hover:bg-ink-2 transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
				Get Started
			</a>
			<button class="md:hidden p-2 -mr-2" aria-label="Menu">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
			</button>
		</div>
	</nav>

	<main>

		<!-- ═══ HERO — H2 Split diptych ═══ -->
		<section class="pt-32 pb-20 md:pt-40 md:pb-28" style="--i:0">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,1.5rem)]">
				<div class="grid md:grid-cols-[1.15fr_1fr] gap-12 md:gap-16 items-start">
					<div class="reveal" style="--i:0">
						<p class="text-sm font-medium font-[var(--font-code)] tracking-wider uppercase text-pollora-coral mb-4">Laravel + WordPress</p>
						<h1 class="font-[var(--font-display)] font-bold text-[clamp(2.5rem,5vw+0.5rem,4.5rem)] leading-[1.08] tracking-tight text-ink mb-6" style="overflow-wrap:anywhere;min-width:0">
							Modern PHP,<br />zero compromise.
						</h1>
						<p class="text-lg text-ink-2 max-w-[52ch] leading-relaxed mb-10">
							Build WordPress sites with Laravel's elegance. PHP 8 attributes, Blade templates, auto-discovery, and a full ecosystem of packages — all working together.
						</p>
						<div class="flex flex-wrap gap-4">
							<a href="/getting-started/installation/" class="inline-flex items-center gap-2 px-7 py-3 rounded-[var(--radius-md)] bg-ink text-paper font-semibold hover:bg-ink-2 transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
								Get Started <span aria-hidden="true">&rarr;</span>
							</a>
							<a href="https://github.com/Pollora" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-7 py-3 rounded-[var(--radius-md)] border border-rule text-ink font-semibold hover:border-ink/30 transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
								View on GitHub
							</a>
						</div>
					</div>
					<div class="reveal rounded-[var(--radius-lg)] overflow-hidden" style="--i:1">
						<div class="bg-code-bg p-6 md:p-8 font-[var(--font-code)] text-sm leading-relaxed">
							<div class="flex items-center gap-2 mb-5">
								<span class="w-3 h-3 rounded-full bg-[oklch(55%_0.20_15)]"></span>
								<span class="w-3 h-3 rounded-full bg-[oklch(75%_0.18_85)]"></span>
								<span class="w-3 h-3 rounded-full bg-[oklch(70%_0.14_155)]"></span>
								<span class="ml-4 text-xs text-muted font-[var(--font-body)]">Book.php</span>
							</div>
							<pre class="text-[0.85rem] md:text-sm"><code><span class="token-keyword">use</span> <span class="token-class">Pollora\Attributes\PostType</span>;
<span class="token-keyword">use</span> <span class="token-class">Pollora\Attributes\ShowInRest</span>;

<span class="token-attribute">#[PostType('book')]</span>
<span class="token-attribute">#[HasArchive]</span>
<span class="token-attribute">#[Supports(['title', 'editor', 'thumbnail'])]</span>
<span class="token-attribute">#[ShowInRest]</span>
<span class="token-keyword">class</span> <span class="token-class">Book</span> <span class="token-punctuation">{}</span>

<span class="token-comment">// That's it. Auto-discovered, registered, ready.</span></code></pre>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══ INSTALL — Terminal demo ═══ -->
		<section class="py-20 md:py-28 bg-paper-2">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,1.5rem)]">
				<div class="reveal max-w-3xl mx-auto text-center mb-12" style="--i:0">
					<h2 class="font-[var(--font-display)] font-bold text-[var(--text-3xl)] tracking-tight mb-4">Up and running in one command</h2>
					<p class="text-ink-2 text-lg">Install the CLI, scaffold a project, start building. WordPress + Laravel, ready in under two minutes.</p>
				</div>
				<div class="reveal max-w-2xl mx-auto" style="--i:1">
					<div class="bg-code-bg rounded-[var(--radius-lg)] p-6 md:p-8 font-[var(--font-code)]">
						<div class="flex items-center gap-3 mb-6 text-xs text-muted">
							<span class="text-pollora-teal">~</span>
							<span class="font-[var(--font-body)]">Terminal</span>
						</div>
						<div class="space-y-4 text-sm">
							<div>
								<span class="text-pollora-teal">$</span>
								<span class="text-[var(--color-accent-ink)] ml-2">composer global require pollora/cli</span>
							</div>
							<div>
								<span class="text-pollora-teal">$</span>
								<span class="text-[var(--color-accent-ink)] ml-2">pollora new my-site --ddev</span>
							</div>
							<div class="pt-2 border-t border-code-surface">
								<span class="text-[oklch(70%_0.14_155)]">&#10003; Project created successfully.</span>
							</div>
							<div>
								<span class="text-[oklch(70%_0.14_155)]">&#10003; DDEV environment configured.</span>
							</div>
							<div>
								<span class="text-[oklch(70%_0.14_155)]">&#10003; WordPress installed.</span>
							</div>
							<div class="pt-2">
								<span class="text-pollora-amber">Ready at</span>
								<span class="text-[var(--color-accent-ink)] ml-1">https://my-site.ddev.site</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══ FEATURES — F1 Bento grid (6 tiles, irregular spans) ═══ -->
		<section class="py-20 md:py-28">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,1.5rem)]">
				<div class="reveal mb-14" style="--i:0">
					<h2 class="font-[var(--font-display)] font-bold text-[var(--text-3xl)] tracking-tight mb-4">Built for the modern PHP developer</h2>
					<p class="text-ink-2 text-lg max-w-[55ch]">Everything you need to build WordPress sites with the tooling you already know and love.</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-6 gap-4 md:gap-5">
					<!-- PHP 8 Attributes — 4 col -->
					<div class="reveal md:col-span-4 bg-paper-2 rounded-[var(--radius-lg)] p-7 md:p-9 border border-rule" style="--i:1">
						<div class="text-pollora-coral font-[var(--font-code)] text-xs tracking-wider uppercase font-medium mb-3">PHP 8 Attributes</div>
						<h3 class="font-[var(--font-display)] font-semibold text-[var(--text-xl)] mb-3">Declare, don't register</h3>
						<p class="text-ink-2 mb-5 max-w-[48ch]">Post types, taxonomies, hooks, REST endpoints, schedules — all defined with PHP 8 attributes. No more <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">register_post_type()</code> calls.</p>
						<pre class="bg-code-bg rounded-[var(--radius-md)] p-4 text-[0.8rem] font-[var(--font-code)] overflow-x-auto"><code><span class="token-attribute">#[PostType('product')]</span>
<span class="token-attribute">#[HasArchive]</span>
<span class="token-attribute">#[ShowInRest]</span>
<span class="token-keyword">class</span> <span class="token-class">Product</span> <span class="token-punctuation">{}</span></code></pre>
					</div>
					<!-- Auto-Discovery — 2 col -->
					<div class="reveal md:col-span-2 bg-paper-2 rounded-[var(--radius-lg)] p-7 md:p-9 border border-rule" style="--i:2">
						<div class="text-pollora-teal font-[var(--font-code)] text-xs tracking-wider uppercase font-medium mb-3">Auto-Discovery</div>
						<h3 class="font-[var(--font-display)] font-semibold text-[var(--text-xl)] mb-3">Write it, it works</h3>
						<p class="text-ink-2">No manual registration. Pollora scans your codebase with Spatie's structure discoverer and registers everything automatically. Convention over configuration.</p>
					</div>
					<!-- Blade Templates — 2 col -->
					<div class="reveal md:col-span-2 bg-paper-2 rounded-[var(--radius-lg)] p-7 md:p-9 border border-rule" style="--i:3">
						<div class="text-pollora-amber font-[var(--font-code)] text-xs tracking-wider uppercase font-medium mb-3">Blade Templates</div>
						<h3 class="font-[var(--font-display)] font-semibold text-[var(--text-xl)] mb-3">WordPress data, Laravel syntax</h3>
						<p class="text-ink-2">Replace PHP template files with Blade. Use directives like <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">@posts</code>, <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">@title</code>, <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">@content</code> for clean, readable templates.</p>
					</div>
					<!-- Hybrid Routing — 4 col -->
					<div class="reveal md:col-span-4 bg-paper-2 rounded-[var(--radius-lg)] p-7 md:p-9 border border-rule" style="--i:4">
						<div class="text-pollora-pink font-[var(--font-code)] text-xs tracking-wider uppercase font-medium mb-3">Hybrid Routing</div>
						<h3 class="font-[var(--font-display)] font-semibold text-[var(--text-xl)] mb-3">Laravel routes + WordPress template hierarchy</h3>
						<p class="text-ink-2 mb-5 max-w-[48ch]"><code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">Route::wp()</code> maps WordPress conditions to controllers. Custom routes take priority; the template hierarchy is the fallback.</p>
						<pre class="bg-code-bg rounded-[var(--radius-md)] p-4 text-[0.8rem] font-[var(--font-code)] overflow-x-auto"><code><span class="token-class">Route</span>::<span class="token-function">wp</span>(<span class="token-string">'single'</span>, [<span class="token-class">PostController</span>::<span class="token-keyword">class</span>, <span class="token-string">'show'</span>]);
<span class="token-class">Route</span>::<span class="token-function">wp</span>(<span class="token-string">'page'</span>, <span class="token-string">'contact'</span>, [<span class="token-class">ContactController</span>::<span class="token-keyword">class</span>, <span class="token-string">'index'</span>]);</code></pre>
					</div>
					<!-- Vite + Tailwind — 3 col -->
					<div class="reveal md:col-span-3 bg-paper-2 rounded-[var(--radius-lg)] p-7 md:p-9 border border-rule" style="--i:5">
						<div class="text-pollora-orange font-[var(--font-code)] text-xs tracking-wider uppercase font-medium mb-3">Vite + Tailwind</div>
						<h3 class="font-[var(--font-display)] font-semibold text-[var(--text-xl)] mb-3">Modern asset pipeline</h3>
						<p class="text-ink-2">Vite with HMR, Tailwind CSS v4, and the Asset facade for script and style registration. No more enqueue headaches.</p>
					</div>
					<!-- Type Safety — 3 col -->
					<div class="reveal md:col-span-3 bg-paper-2 rounded-[var(--radius-lg)] p-7 md:p-9 border border-rule" style="--i:6">
						<div class="text-pollora-red font-[var(--font-code)] text-xs tracking-wider uppercase font-medium mb-3">Type Safety</div>
						<h3 class="font-[var(--font-display)] font-semibold text-[var(--text-xl)] mb-3">PHPStan, typed methods, IDE autocompletion</h3>
						<p class="text-ink-2">Constructor property promotion, explicit return types, type-hinted parameters everywhere. PHPStan level 5 enforced across the framework.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══ CODE COMPARISON — Before / After ═══ -->
		<section class="py-20 md:py-28 bg-paper-2">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,1.5rem)]">
				<div class="reveal mb-14" style="--i:0">
					<h2 class="font-[var(--font-display)] font-bold text-[var(--text-3xl)] tracking-tight mb-4">The difference is visible</h2>
					<p class="text-ink-2 text-lg max-w-[55ch]">Register a custom post type. Left: WordPress traditional. Right: Pollora.</p>
				</div>
				<div class="reveal grid md:grid-cols-2 gap-5" style="--i:1">
					<!-- WordPress Traditional -->
					<div>
						<div class="flex items-center gap-2 mb-3">
							<span class="w-2 h-2 rounded-full bg-neutral"></span>
							<span class="text-sm font-medium text-muted">WordPress — 30+ lines</span>
						</div>
						<div class="bg-code-bg rounded-[var(--radius-lg)] p-5 md:p-7 font-[var(--font-code)] text-[0.78rem] leading-relaxed overflow-x-auto h-full">
							<pre><code><span class="token-keyword">function</span> <span class="token-function">register_book_post_type</span>() <span class="token-punctuation">{</span>
    <span class="token-function">register_post_type</span>(<span class="token-string">'book'</span>, [
        <span class="token-string">'labels'</span> => [
            <span class="token-string">'name'</span>          => <span class="token-string">'Books'</span>,
            <span class="token-string">'singular_name'</span> => <span class="token-string">'Book'</span>,
            <span class="token-string">'add_new'</span>       => <span class="token-string">'Add New Book'</span>,
            <span class="token-string">'add_new_item'</span>  => <span class="token-string">'Add New Book'</span>,
            <span class="token-string">'edit_item'</span>     => <span class="token-string">'Edit Book'</span>,
            <span class="token-string">'view_item'</span>     => <span class="token-string">'View Book'</span>,
            <span class="token-string">'search_items'</span>  => <span class="token-string">'Search Books'</span>,
        ],
        <span class="token-string">'public'</span>       => <span class="token-keyword">true</span>,
        <span class="token-string">'has_archive'</span>  => <span class="token-keyword">true</span>,
        <span class="token-string">'show_in_rest'</span> => <span class="token-keyword">true</span>,
        <span class="token-string">'supports'</span>     => [
            <span class="token-string">'title'</span>,
            <span class="token-string">'editor'</span>,
            <span class="token-string">'thumbnail'</span>,
        ],
        <span class="token-string">'rewrite'</span> => [
            <span class="token-string">'slug'</span> => <span class="token-string">'books'</span>,
        ],
    ]);
<span class="token-punctuation">}</span>
<span class="token-function">add_action</span>(<span class="token-string">'init'</span>, <span class="token-string">'register_book_post_type'</span>);</code></pre>
						</div>
					</div>
					<!-- Pollora -->
					<div>
						<div class="flex items-center gap-2 mb-3">
							<span class="w-2 h-2 rounded-full bg-pollora-coral"></span>
							<span class="text-sm font-medium text-pollora-coral">Pollora — 6 lines</span>
						</div>
						<div class="bg-code-bg rounded-[var(--radius-lg)] p-5 md:p-7 font-[var(--font-code)] text-[0.78rem] leading-relaxed overflow-x-auto h-full">
							<pre><code><span class="token-keyword">use</span> <span class="token-class">Pollora\Attributes\PostType</span>;
<span class="token-keyword">use</span> <span class="token-class">Pollora\Attributes\HasArchive</span>;
<span class="token-keyword">use</span> <span class="token-class">Pollora\Attributes\ShowInRest</span>;
<span class="token-keyword">use</span> <span class="token-class">Pollora\Attributes\Supports</span>;

<span class="token-attribute">#[PostType('book')]</span>
<span class="token-attribute">#[HasArchive]</span>
<span class="token-attribute">#[Supports(['title', 'editor', 'thumbnail'])]</span>
<span class="token-attribute">#[ShowInRest]</span>
<span class="token-keyword">class</span> <span class="token-class">Book</span> <span class="token-punctuation">{}</span>

<span class="token-comment">// Auto-discovered. Auto-registered.</span>
<span class="token-comment">// Labels generated from the class name.</span>
<span class="token-comment">// No add_action() needed.</span></code></pre>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══ ECOSYSTEM ═══ -->
		<section id="ecosystem" class="py-20 md:py-28">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,1.5rem)]">
				<div class="reveal mb-14" style="--i:0">
					<h2 class="font-[var(--font-display)] font-bold text-[var(--text-3xl)] tracking-tight mb-4">A complete ecosystem</h2>
					<p class="text-ink-2 text-lg max-w-[55ch]">Modular packages that work independently or together. Each one solves one problem well.</p>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
					<a href="https://github.com/Pollora/cli" target="_blank" rel="noopener" class="reveal group bg-paper-2 rounded-[var(--radius-lg)] p-7 border border-rule hover:border-pollora-coral/30 transition-colors duration-[var(--dur-short)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]" style="--i:1">
						<div class="font-[var(--font-code)] text-pollora-coral text-xs tracking-wider uppercase font-medium mb-3">pollora/cli</div>
						<h3 class="font-[var(--font-display)] font-semibold text-[var(--text-md)] mb-2 group-hover:text-pollora-coral transition-colors duration-[var(--dur-micro)]">CLI</h3>
						<p class="text-ink-2 text-sm">Scaffold projects in one command. Interactive setup with optional DDEV integration. Global binary.</p>
					</a>
					<a href="https://github.com/Pollora/colt" target="_blank" rel="noopener" class="reveal group bg-paper-2 rounded-[var(--radius-lg)] p-7 border border-rule hover:border-pollora-teal/30 transition-colors duration-[var(--dur-short)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]" style="--i:2">
						<div class="font-[var(--font-code)] text-pollora-teal text-xs tracking-wider uppercase font-medium mb-3">pollora/colt</div>
						<h3 class="font-[var(--font-display)] font-semibold text-[var(--text-md)] mb-2 group-hover:text-pollora-teal transition-colors duration-[var(--dur-micro)]">Colt</h3>
						<p class="text-ink-2 text-sm">Eloquent ORM models for WordPress. Access posts, users, taxonomies, and options with Laravel's query builder.</p>
					</a>
					<a href="https://github.com/Pollora/entity" target="_blank" rel="noopener" class="reveal group bg-paper-2 rounded-[var(--radius-lg)] p-7 border border-rule hover:border-pollora-amber/30 transition-colors duration-[var(--dur-short)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]" style="--i:3">
						<div class="font-[var(--font-code)] text-pollora-amber text-xs tracking-wider uppercase font-medium mb-3">pollora/entity</div>
						<h3 class="font-[var(--font-display)] font-semibold text-[var(--text-md)] mb-2 group-hover:text-pollora-amber transition-colors duration-[var(--dur-micro)]">Entity</h3>
						<p class="text-ink-2 text-sm">Fluent interface for post types and taxonomies. Hexagonal architecture with full type safety.</p>
					</a>
					<a href="https://github.com/Pollora/query" target="_blank" rel="noopener" class="reveal group bg-paper-2 rounded-[var(--radius-lg)] p-7 border border-rule hover:border-pollora-orange/30 transition-colors duration-[var(--dur-short)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]" style="--i:4">
						<div class="font-[var(--font-code)] text-pollora-orange text-xs tracking-wider uppercase font-medium mb-3">pollora/query</div>
						<h3 class="font-[var(--font-display)] font-semibold text-[var(--text-md)] mb-2 group-hover:text-pollora-orange transition-colors duration-[var(--dur-micro)]">Query</h3>
						<p class="text-ink-2 text-sm">Fluent WP_Query wrapper. Type-safe method chaining with IDE autocompletion for readable post queries.</p>
					</a>
