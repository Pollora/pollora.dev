		</section>

		<!-- ═══ CTA ═══ -->
		<section class="pl-deferred py-28 md:py-36 bg-code-bg relative overflow-hidden">
			<div class="absolute inset-0 opacity-[0.07]" style="background: radial-gradient(ellipse at 50% 0%, #ff5334, transparent 70%)"></div>
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)] relative">
				<div data-reveal class="grid md:grid-cols-[1.2fr_1fr] gap-12 items-center" style="--i:0">
					<div class="text-center md:text-left">

						<h2 class="font-[var(--font-display)] font-bold text-[clamp(3rem,4vw+0.5rem,5.5rem)] leading-[1.05] tracking-tight mb-7 text-[var(--color-accent-ink)]" style="overflow-wrap:anywhere;min-width:0">
							Start building with <span class="text-gradient">Pollora</span>
