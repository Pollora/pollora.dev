	<footer class="bg-code-bg border-t border-code-surface">
		<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)] py-10 flex flex-col sm:flex-row items-center justify-between gap-5">
			<div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-base text-muted">
				<a href="/getting-started/installation/" class="hover:text-neutral transition-colors duration-[var(--dur-micro)]">Docs</a>
				<a href="https://github.com/Pollora" target="_blank" rel="noopener" class="hover:text-neutral transition-colors duration-[var(--dur-micro)]">GitHub</a>
				<a href="/llms.txt" class="hover:text-neutral transition-colors duration-[var(--dur-micro)]">llms.txt</a>
				<a href="mailto:support@pollora.dev" class="text-sm font-[var(--font-code)] hover:text-neutral transition-colors duration-[var(--dur-micro)]">support@pollora.dev</a>
			</div>
			<div class="text-sm text-muted text-center sm:text-right space-y-1">
				<p>Pollora is open source under the MIT license.</p>
				<p>Built by <a href="https://amphibee.fr" target="_blank" rel="noopener" class="text-neutral hover:text-[var(--color-accent-ink)] transition-colors duration-[var(--dur-micro)]">AmphiBee</a>, backed by <a href="https://rubee.group" target="_blank" rel="noopener" class="text-neutral hover:text-[var(--color-accent-ink)] transition-colors duration-[var(--dur-micro)]">RuBee</a>.</p>
			</div>
		</div>
	</footer>


	<script define:vars={{ terminalSequence }}>
		window.__terminalSequence = terminalSequence;
	</script>
	<script>
		import Alpine from 'alpinejs';

		// Pollora peek — eye tracking
		Alpine.data('polloraPeek', () => ({
			track(e) {
				const svg = document.getElementById('mascot-peek');
				if (!svg) return;

				const rect = svg.getBoundingClientRect();
				const svgCX = rect.left + rect.width / 2;
				const svgCY = rect.top + rect.height / 2;

				const dx = e.clientX - svgCX;
				const dy = e.clientY - svgCY;
				const dist = Math.sqrt(dx * dx + dy * dy) || 1;
				const nx = dx / dist;
				const ny = dy / dist;

				const maxMove = 18;
				const factor = Math.min(dist / 300, 1);
				const moveX = nx * maxMove * factor;
				const moveY = ny * maxMove * factor;

				const p1 = document.getElementById('pupil-1');
				const p2 = document.getElementById('pupil-2');
				if (p1) p1.setAttribute('transform', `translate(${moveX}, ${moveY})`);
				if (p2) p2.setAttribute('transform', `translate(${moveX}, ${moveY})`);
			}
		}));

		// Terminal animation
		Alpine.data('terminalAnim', () => ({
			lines: [],
			_id: 0,
			_stopped: false,
			_started: false,

			init() {
				const obs = new IntersectionObserver(entries => {
					if (entries[0].isIntersecting && !this._started) {
						this._started = true;
						this.run();
					}
				}, { threshold: 0.2 });
				obs.observe(this.$el);
			},

			// Helpers
			_sleep(ms) {
				return new Promise(r => setTimeout(r, ms));
			},
			_esc(s) {
				return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
			},
			_scroll() {
				this.$nextTick(() => {
					const el = this.$refs.scroll;
					if (el) el.scrollTop = el.scrollHeight;
				});
			},
			_addLine(html, cls = '') {
				const id = this._id++;
				this.lines.push({ id, html, cls });
				this._scroll();
				return id;
			},
			_updateLine(id, html) {
				const l = this.lines.find(x => x.id === id);
				if (l) l.html = html;
			},

			// Step runners
			async _doCommand(step) {
				const text = step.text;
				const id = this._addLine('<span class="term-teal">$</span> <span class="term-cursor">█</span>');
				await this._sleep(400);
				for (let i = 0; i <= text.length; i++) {
					this._updateLine(id,
						`<span class="term-teal">$</span> <span class="term-accent">${this._esc(text.slice(0, i))}</span><span class="term-cursor">█</span>`
					);
					await this._sleep(28 + Math.random() * 42);
				}
				this._updateLine(id, `<span class="term-teal">$</span> <span class="term-accent">${this._esc(text)}</span>`);
				await this._sleep(400);
			},

			async _doOutput(step) {
				const style = step.style || '';
				let cls = '';
				if (style === 'success') cls = 'term-green';
				else if (style === 'muted') cls = 'term-muted';
				else if (style === 'info') cls = 'term-info';
				else if (style === 'url') cls = 'term-url';
				else if (style === 'banner') cls = 'term-banner';
				else if (style === 'success-box') cls = 'term-success-box font-bold';

				for (const line of step.lines) {
					this._addLine(this._esc(line), cls);
					await this._sleep(style === 'banner' ? 15 : 60);
				}
			},

			// W = inner width (chars between │ and │). Total box width = W + 2
			_W: 58,

			_promptTop(question) {
				const dashes = '─'.repeat(Math.max(1, this._W - question.length - 2));
				return `<span class="term-prompt-border">┌</span> <span class="term-accent">${this._esc(question)}</span> <span class="term-prompt-border">${dashes}┐</span>`;
			},
			_promptMid(content, contentLen, colorCls = 'term-accent') {
				const spaces = ' '.repeat(Math.max(0, this._W - contentLen - 1));
				return `<span class="term-prompt-border">│</span> <span class="${colorCls}">${content}</span>${spaces}<span class="term-prompt-border">│</span>`;
			},
			_promptBot() {
				return `<span class="term-prompt-border">└${'─'.repeat(this._W)}┘</span>`;
			},

			async _doPrompt(step) {
				// Top border
				this._addLine(this._promptTop(step.question));

				// Middle — empty with cursor
				const midId = this._addLine(this._promptMid('<span class="term-cursor">█</span>', 1));
				await this._sleep(250);

				// Type the answer char by char
				const answer = step.answer;
				for (let i = 0; i <= answer.length; i++) {
					const typed = this._esc(answer.slice(0, i));
					this._updateLine(midId, this._promptMid(`${typed}<span class="term-cursor">█</span>`, i + 1));
					await this._sleep(35 + Math.random() * 35);
				}

				// Final state — no cursor
				const spaces = ' '.repeat(Math.max(0, this._W - answer.length - 1));
				this._updateLine(midId,
					`<span class="term-prompt-border">│</span> <span class="term-accent">${this._esc(answer)}</span>${spaces}<span class="term-prompt-border">│</span>`
				);

				// Bottom border
				this._addLine(this._promptBot());
				await this._sleep(350);
			},

			async _doSelect(step) {
				const answer = step.answer;

				// Top border
				this._addLine(this._promptTop(step.question));

				// Middle — empty, then answer appears
				const emptySpaces = ' '.repeat(Math.max(0, this._W - 1));
				const midId = this._addLine(`<span class="term-prompt-border">│</span>${emptySpaces} <span class="term-prompt-border">│</span>`);
				await this._sleep(500);

				const spaces = ' '.repeat(Math.max(0, this._W - answer.length - 1));
				this._updateLine(midId,
					`<span class="term-prompt-border">│</span> <span class="term-green">${this._esc(answer)}</span>${spaces}<span class="term-prompt-border">│</span>`
				);

				// Bottom border
				this._addLine(this._promptBot());
				await this._sleep(350);
			},

			async _doProgress(step) {
				const total = step.total || 100;
				const duration = step.duration || 1500;
				const barWidth = 28;
				const steps = 12;

				const id = this._addLine('');
				for (let i = 0; i <= steps; i++) {
					const pct = Math.min(Math.round((i / steps) * 100), 100);
					const current = Math.round((i / steps) * total);
					const filled = Math.round((i / steps) * barWidth);
					const empty = barWidth - filled;
					const bar = '='.repeat(filled) + (empty > 0 ? '>' + '-'.repeat(Math.max(0, empty - 1)) : '');
					const pctStr = pct.toString().padStart(3, ' ');
					this._updateLine(id,
						`<span class="term-muted">${current}/${total} [${bar}] ${pctStr}%</span>`
					);
					await this._sleep(duration / steps);
				}
			},

			async _doMigrations(step) {
				for (const m of step.items) {
					const name = m.name;
					const dots = '.'.repeat(Math.max(0, 50 - name.length));
					const id = this._addLine(`<span class="term-accent">${this._esc(name)}</span><span class="term-muted"> ${dots}</span>`);
					await this._sleep(200 + Math.random() * 300);
					this._updateLine(id,
						`<span class="term-accent">${this._esc(name)}</span><span class="term-muted"> ${dots} ${m.time}</span> <span class="term-green">DONE</span>`
					);
					await this._sleep(100);
				}
			},

			async run() {
				const sequence = window.__terminalSequence;
				while (true) {
					this.lines = [];
					this._id = 0;

					for (const step of sequence) {
						switch (step.type) {
							case 'command': await this._doCommand(step); break;
							case 'output': await this._doOutput(step); break;
							case 'prompt': await this._doPrompt(step); break;
							case 'select': await this._doSelect(step); break;
							case 'progress': await this._doProgress(step); break;
							case 'migrations': await this._doMigrations(step); break;
							case 'pause': await this._sleep(step.ms || 500); break;
						}
					}

					// Pause before restarting
					await this._sleep(6000);
				}
			}
		}));

		// Video tour modal
		Alpine.store('tour', {
			open: false,
			lastFocus: null,
			show() {
				this.lastFocus = document.activeElement;
				this.open = true;
				document.documentElement.style.overflow = 'hidden';
				setTimeout(() => document.querySelector('[aria-label="Close video"]')?.focus(), 50);
			},
			hide() {
				this.open = false;
				document.documentElement.style.overflow = '';
				this.lastFocus?.focus();
			},
		});

		Alpine.start();

		// Reveal on scroll
		const io = new IntersectionObserver((entries) => {
			entries.forEach((e) => {
				if (e.isIntersecting) { e.target.classList.add('shown'); io.unobserve(e.target); }
			});
		}, { threshold: 0.08 });
		document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
	</script>
</body>
</html>
