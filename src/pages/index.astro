---
import mascotDeveloper from '../assets/mascot-developer.svg';
import mascotDocs from '../assets/mascot-documentation.svg';
import mascotGithub from '../assets/mascot-github.svg';
import themeDefault from '../assets/themes/default.png';
import themeApiary from '../assets/themes/apiary.png';
import themeBuzz from '../assets/themes/buzz.png';
import { Image } from 'astro:assets';
import LatestPosts from '../components/blog/LatestPosts.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { social } from '../lib/site';
import { compact, monthlyInstalls } from '../lib/stats';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// Packagist installs of pollora/framework over the last 30 days, shown in the hero (null: left out)
const installs = await monthlyInstalls();

// Current release, shown in the hero badge and in the structured data
const version = '13.35.4';

const siteUrl = 'https://pollora.dev/';
const ogImage = new URL('/og/index.png', siteUrl).href;
const title = 'Pollora: the Laravel framework for WordPress';
const description = "The modern PHP framework that blends Laravel's elegance with WordPress's power. PHP 8 attributes, Blade templates, auto-discovery — zero compromise.";
const socialDescription = 'Modern PHP framework blending Laravel and WordPress. PHP 8 attributes, auto-discovery, Blade templates.';

// schema.org description of the framework, read by search engines
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Pollora',
	url: siteUrl,
	description,
	applicationCategory: 'DeveloperApplication',
	applicationSubCategory: 'PHP framework',
	operatingSystem: 'Cross-platform',
	softwareVersion: version,
	license: 'https://opensource.org/licenses/MIT',
	image: ogImage,
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	sameAs: [
		'https://github.com/Pollora/framework',
		'https://packagist.org/packages/pollora/pollora',
		social.github,
		social.x,
	],
};

// YouTube ID of the 1-minute tour
const youtubeId = 'Wk1VzPapqM8';
const tourEmbedUrl = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0&playsinline=1`;

const terminalSequence = JSON.parse(readFileSync(resolve('sources/terminal-sequence.json'), 'utf-8'));
const peekRaw = readFileSync(resolve('src/assets/mascot-peek.svg'), 'utf-8');
// Crop to top portion (eyes area) and clean up Inkscape metadata
const peekSvg = peekRaw
	.replace(/viewBox="[^"]*"/, 'viewBox="100 50 1900 850"')
	.replace(/<sodipodi:namedview[\s\S]*?\/>/g, '')
	.replace(/<\?xml[^>]*\?>/g, '')
	.replace(/xmlns:inkscape="[^"]*"/g, '')
	.replace(/xmlns:sodipodi="[^"]*"/g, '')
	.replace(/inkscape:[a-z-]+="[^"]*"/g, '')
	.replace(/sodipodi:[a-z-]+="[^"]*"/g, '')
	.replace(/id="svg82"/, 'id="mascot-peek"')
	.replace(/id="g82"/, 'id="pupil-2"')
	.replace(/id="g83"/, 'id="pupil-1"')
	.replace('display="block"', 'display="block" class="w-full h-auto"');

// "How it compares": a table from tablet width, one card per tool on phones
const compareRows = ['Approach', 'Front end', 'Post types & hooks', 'Price'];
const compareTools = [
	{ name: 'Pollora', kind: 'Framework', pollora: true, cells: ['WordPress inside a Laravel app', 'Laravel routes, controllers, Blade, template hierarchy fallback', 'PHP 8 attributes, auto-discovered', 'Free, MIT'] },
	{ name: 'Acorn + Sage', kind: 'Theme toolkit', cells: ['Laravel components inside WordPress', 'Blade theme on the template hierarchy', 'Theme or plugin code', 'Free, MIT'] },
	{ name: 'Radicle', kind: 'Starter kit', cells: ['Roots stack starter, Laravel-powered', 'Blade theme, Laravel features', 'Configuration file', 'One-time purchase'] },
];
const priceRow = compareRows.indexOf('Price');
const attributeRow = compareRows.indexOf('Post types & hooks');

// "A complete ecosystem": every package as a compact tile, its hexagon in the package's colour
const packages = [
	{ name: 'Entity', id: 'pollora/entity', kind: 'Core', color: '#feb017', repo: 'WordPressEntity', text: 'Fluent post types and taxonomies, built on Extended CPTs.' },
	{ name: 'Query', id: 'pollora/query', kind: 'Core', color: '#ff8c12', repo: 'Query', text: 'A fluent, typed WP_Query with IDE autocompletion.' },
	{ name: 'Colt', id: 'pollora/colt', kind: 'Core', color: '#49c7b9', repo: 'colt', text: 'Eloquent models for posts, users, terms and options.' },
	{ name: 'Hook', id: 'pollora/hook', kind: 'Core', color: '#fb196d', repo: 'hook', text: 'Actions and filters as objects, with reflection caching.' },
	{ name: 'Ajax', id: 'pollora/ajax', kind: 'Core', color: '#ff314c', repo: 'ajax', text: 'AJAX actions with a fluent API, private by default.' },
	{ name: 'Option', id: 'pollora/option', kind: 'Core', color: '#49c7b9', repo: 'option', text: 'Typed WordPress options, validated, with smart upserts.' },
	{ name: 'Abilities', id: 'pollora/abilities', kind: 'Core', color: '#ff5334', repo: 'abilities', text: 'The WordPress Abilities API, ready for AI agents and MCP.' },
	{ name: 'CLI', id: 'pollora/cli', kind: 'Tool', color: '#ff5334', repo: 'cli', text: 'A new project in one command, DDEV setup included.' },
	{ name: 'Nectar', id: 'pollora/nectar', kind: 'Tool', color: '#fb196d', repo: 'nectar', text: 'AI context for coding agents: MCP tools and skills.' },
	{ name: 'MCP Connector', id: 'pollora/mcp-connector', kind: 'Plugin', color: '#49c7b9', repo: 'McpConnector', text: 'Connect Claude and other MCP clients to WordPress by URL.' },
	{ name: 'AI Visibility', id: 'pollora/ai-visibility', kind: 'Plugin', color: '#feb017', repo: 'AiVisibility', text: 'llms.txt, a Markdown twin of every page, AI crawler rules.' },
	{ name: 'Portcullis', id: 'pollora/portcullis', kind: 'Plugin', color: '#ff8c12', repo: 'portcullis', text: 'A secret login URL, real 404s and brute-force lockouts.' },
];
---

<SiteLayout title={title} description={description} socialDescription={socialDescription} structuredData={structuredData}>

		<!-- ═══ HERO ═══ -->
		<section class="pt-36 pb-24 md:pt-44 md:pb-32 relative">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)]">
				<div class="grid md:grid-cols-[1.2fr_1fr] gap-12 md:gap-20 items-start">
					<div class="pl-hero-in" style="--i:0">
						<div class="flex flex-wrap items-center gap-3 mb-5">
							<p class="text-base font-semibold font-[var(--font-code)] tracking-wider uppercase text-gradient">Modern PHP, zero compromise</p>
							<a href="https://github.com/Pollora/framework/releases" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-3 py-1 rounded-[var(--radius-pill)] border border-rule bg-paper-2 text-sm font-semibold font-[var(--font-code)] text-ink-2 hover:border-pollora-coral/40 hover:text-ink transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
								<span class="w-2 h-2 rounded-full bg-pollora-coral" aria-hidden="true"></span>
								v{version}
							</a>
							{installs && (
								<a href="https://packagist.org/packages/pollora/framework/stats" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-3 py-1 rounded-[var(--radius-pill)] border border-rule bg-paper-2 text-sm font-semibold font-[var(--font-code)] text-ink-2 hover:border-pollora-teal/50 hover:text-ink transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
									<span class="w-2 h-2 rounded-full bg-pollora-teal" aria-hidden="true"></span>
									{compact(installs)} installs / month
								</a>
							)}
						</div>
						<h1 class="font-[var(--font-display)] font-bold text-[clamp(3rem,4vw+0.5rem,5.5rem)] leading-[1.05] tracking-tight text-ink mb-8" style="overflow-wrap:anywhere;min-width:0">
							The Laravel framework<br /><span class="text-gradient">for WordPress.</span>
						</h1>
						<p class="text-lg text-ink-2 max-w-[50ch] leading-relaxed mb-12">
							WordPress runs inside a Laravel app: routing, controllers, Blade and Eloquent on the front end, the admin and plugins untouched. PHP 8 attributes and auto-discovery do the registering.
						</p>
						<div class="flex flex-wrap gap-4">
							<a href="/getting-started/installation/" class="inline-flex items-center gap-2.5 px-8 py-3.5 rounded-[var(--radius-md)] bg-gradient-pollora text-white text-lg font-semibold hover:opacity-90 transition-opacity duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
								Get Started <span aria-hidden="true">&rarr;</span>
							</a>
							<a href="https://github.com/Pollora" target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 px-8 py-3.5 rounded-[var(--radius-md)] border-2 border-rule text-ink text-lg font-semibold hover:border-pollora-coral/40 transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
								View on GitHub
							</a>
						</div>
						<button type="button" x-data @click="$store.tour.show()" data-track="tour_video_play" class="group mt-8 inline-flex items-center gap-3 text-base font-semibold text-ink-2 hover:text-ink transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-focus)] rounded-[var(--radius-pill)]">
							<span class="grid place-items-center w-11 h-11 rounded-full bg-gradient-pollora text-white shadow-[0_0_20px_rgba(255,83,52,0.35)] group-hover:scale-110 transition-transform duration-[var(--dur-short)]"><svg class="w-5 h-5 translate-x-[8%]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.9-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z"/></svg></span>
							Watch the 1-min tour
							<span class="font-[var(--font-code)] text-sm font-normal text-muted">1:06</span>
						</button>
					</div>
					<div class="pl-hero-in rounded-[var(--radius-lg)] overflow-hidden shadow-2xl shadow-pollora-dark/10" style="--i:1">
						<div class="bg-code-bg p-6 md:p-8 pb-24 md:pb-28 font-[var(--font-code)] text-[0.9rem] md:text-base leading-relaxed">
							<div class="flex items-center gap-2 mb-6">
								<span class="w-3 h-3 rounded-full bg-pollora-pink"></span>
								<span class="w-3 h-3 rounded-full bg-pollora-amber"></span>
								<span class="w-3 h-3 rounded-full bg-pollora-teal"></span>
								<span class="ml-4 text-sm text-neutral font-[var(--font-body)]">Book.php</span>
							</div>
							<pre><code><span class="token-keyword">use</span> <span class="token-class">Pollora\Attributes\PostType</span>;
<span class="token-keyword">use</span> <span class="token-class">Pollora\Attributes\PostType\&#123;HasArchive, Supports, ShowInRest&#125;</span>;

<span class="token-attribute">#[PostType('book')]</span>
<span class="token-attribute">#[HasArchive]</span>
<span class="token-attribute">#[Supports(['title', 'editor', 'thumbnail'])]</span>
<span class="token-attribute">#[ShowInRest]</span>
<span class="token-keyword">class</span> <span class="token-class">Book</span> <span class="token-punctuation">&#123;&#125;</span>

<span class="token-comment">// That's it. Auto-discovered, registered, ready.</span></code></pre>
						</div>
					</div>
				</div>
			</div>

			<!-- Mascot peek — absolute, bottom-right of hero -->
			<div x-data="polloraPeek()" @mousemove.window="track($event)" class="absolute bottom-0 right-0 z-10 pointer-events-none w-full" aria-hidden="true">
				<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)]">
					<div class="grid md:grid-cols-[1.2fr_1fr]">
						<div></div>
						<div class="flex justify-end">
							<div class="w-80 md:w-120 lg:w-140">
								<Fragment set:html={peekSvg} />
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══ INSTALL ═══ -->
		<section class="py-24 md:py-32 bg-paper-2">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)]">
				<div data-reveal class="max-w-3xl mx-auto text-center mb-14" style="--i:0">
					<h2 class="font-[var(--font-display)] font-bold text-[clamp(2rem,3.5vw+0.5rem,3rem)] leading-[1.1] tracking-tight mb-5">Up and running in <span class="text-gradient">one command</span></h2>
					<p class="text-ink-2 text-lg">Install the CLI, scaffold a project, start building. WordPress + Laravel, ready in under two minutes.</p>
				</div>
				<div data-reveal class="max-w-3xl mx-auto relative" style="--i:1">
					<div x-data="terminalAnim()" class="bg-code-bg rounded-[var(--radius-lg)] shadow-2xl shadow-pollora-dark/10 overflow-hidden">
						<!-- Title bar -->
						<div class="flex items-center gap-2 px-5 py-3.5 border-b border-code-surface">
							<span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
							<span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
							<span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
							<span class="ml-3 text-sm text-neutral font-[var(--font-body)]">Terminal</span>
						</div>
						<!-- Terminal content -->
						<div x-ref="scroll" class="terminal-scroll px-5 md:px-7 py-5 text-[0.72rem] md:text-[0.82rem] leading-[1.6] overflow-y-auto" style="height: 420px; max-height: 55vh; font-family: 'JetBrains Mono', ui-monospace, monospace;">
							<template x-for="line in lines" :key="line.id">
								<div :class="line.cls" x-html="line.html" class="whitespace-pre"></div>
							</template>
						</div>
					</div>
					<img src={mascotDeveloper.src} alt="Pollora mascot" class="hidden md:block absolute -bottom-12 -right-16 lg:-right-24 w-44 lg:w-56 pointer-events-none drop-shadow-[0_0_20px_rgba(255,83,52,0.2)]" width="224" height="224" loading="lazy" />
				</div>
				<!-- The command itself, to copy: tracked as copy_code / install-command -->
				<div x-data="{ copied: false }" class="pl-install-cmd max-w-3xl mx-auto">
					<code><span class="text-pollora-teal select-none">$ </span><span x-ref="cmd">composer global require pollora/cli &amp;&amp; pollora new example-app</span></code>
					<button type="button" @click="navigator.clipboard.writeText($refs.cmd.textContent).then(() => { copied = true; window.dataLayer?.push({ event: 'copy_code', code_language: 'install-command' }); setTimeout(() => copied = false, 2000) })" :aria-label="copied ? 'Copied' : 'Copy the install command'">
						<span x-text="copied ? 'Copied' : 'Copy'">Copy</span>
					</button>
				</div>
			</div>
		</section>

		<!-- ═══ FEATURES — Bento grid ═══ -->
		<section class="pl-deferred py-24 md:py-32">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)]">
				<div data-reveal class="mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-5" style="--i:0">
					<div>
						<h2 class="font-[var(--font-display)] font-bold text-[clamp(2rem,3.5vw+0.5rem,3rem)] leading-[1.1] tracking-tight mb-5">Built for the <span class="text-gradient">modern PHP developer</span></h2>
						<p class="text-ink-2 text-lg max-w-[55ch]">Everything you need to build WordPress sites with the tooling you already know and love.</p>
					</div>
					<a href="/features/" class="inline-flex items-center gap-1.5 text-base font-semibold text-ink hover:text-pollora-coral transition-colors duration-[var(--dur-micro)] shrink-0">All features <span aria-hidden="true">&rarr;</span></a>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-6 gap-5">
					<!-- PHP 8 Attributes + auto-discovery — 3 col -->
					<div data-reveal class="md:col-span-3 group bg-paper-2 rounded-[var(--radius-lg)] p-8 md:p-10 border border-rule hover:border-pollora-coral/30 transition-all duration-[var(--dur-short)]" style="--i:1">
						<div class="text-gradient font-[var(--font-code)] text-sm tracking-wider uppercase font-semibold mb-4">PHP 8 Attributes</div>
						<h3 class="font-[var(--font-display)] font-bold text-[var(--text-xl)] mb-3">Declare, don't register</h3>
						<p class="text-ink-2 text-base mb-6 max-w-[48ch]">Post types, taxonomies, hooks, REST endpoints, WP-CLI commands, schedules: a class and an attribute. Pollora finds them and registers them for you. No more <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">register_post_type()</code> calls.</p>
						<pre class="bg-code-bg rounded-[var(--radius-md)] p-5 text-[0.85rem] md:text-[0.9rem] font-[var(--font-code)] overflow-x-auto"><code><span class="token-attribute">#[PostType('product')]</span>
<span class="token-attribute">#[HasArchive]</span>
<span class="token-attribute">#[ShowInRest]</span>
<span class="token-keyword">class</span> <span class="token-class">Product</span> <span class="token-punctuation">&#123;&#125;</span></code></pre>
						<a href="/guides/custom-post-types-php-attributes/" class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-ink hover:text-pollora-coral transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">Post types with attributes <span aria-hidden="true">&rarr;</span></a>
					</div>
					<!-- Async actions — 3 col -->
					<div data-reveal class="md:col-span-3 group relative bg-paper-2 rounded-[var(--radius-lg)] p-8 md:p-10 border border-rule hover:border-pollora-teal/30 transition-all duration-[var(--dur-short)]" style="--i:2">
						<span class="absolute top-6 right-6 px-2.5 py-1 rounded-[var(--radius-pill)] bg-pollora-teal/15 text-[oklch(45%_0.09_185)] text-xs font-semibold font-[var(--font-code)]">New in 13.35.2</span>
						<div class="text-pollora-teal font-[var(--font-code)] text-sm tracking-wider uppercase font-semibold mb-4">Async actions</div>
						<h3 class="font-[var(--font-display)] font-bold text-[var(--text-xl)] mb-3">Slow work, after the response</h3>
						<p class="text-ink-2 text-base mb-6">One call moves a WordPress action to a Laravel queue, Action Scheduler or WP-Cron, with delays and retries.</p>
						<pre class="bg-code-bg rounded-[var(--radius-md)] p-5 text-[0.85rem] md:text-[0.9rem] font-[var(--font-code)] overflow-x-auto"><code><span class="token-class">Action</span>::<span class="token-function">add</span>(<span class="token-string">'save_post'</span>, <span class="token-variable">$handler</span>)
    -&gt;<span class="token-function">async</span>()
    -&gt;<span class="token-function">tries</span>(<span class="token-attribute">3</span>);</code></pre>
						<a href="/hooks/async-actions/" class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-ink hover:text-pollora-coral transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">Asynchronous actions <span aria-hidden="true">&rarr;</span></a>
					</div>
					<!-- Hybrid Routing — 4 col -->
					<div data-reveal class="md:col-span-4 group bg-paper-2 rounded-[var(--radius-lg)] p-8 md:p-10 border border-rule hover:border-pollora-pink/30 transition-all duration-[var(--dur-short)]" style="--i:3">
						<div class="text-pollora-pink font-[var(--font-code)] text-sm tracking-wider uppercase font-semibold mb-4">Hybrid Routing</div>
						<h3 class="font-[var(--font-display)] font-bold text-[var(--text-xl)] mb-3">Laravel routes + WordPress fallback</h3>
						<p class="text-ink-2 text-base mb-6"><code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">Route::wp()</code> maps WordPress conditions to controllers. Custom routes take priority; the template hierarchy handles the rest.</p>
						<pre class="bg-code-bg rounded-[var(--radius-md)] p-5 text-[0.85rem] md:text-[0.9rem] font-[var(--font-code)] overflow-x-auto"><code><span class="token-class">Route</span>::<span class="token-function">wp</span>(<span class="token-string">'single'</span>, [<span class="token-class">PostController</span>::<span class="token-keyword">class</span>, <span class="token-string">'show'</span>]);
<span class="token-class">Route</span>::<span class="token-function">wp</span>(<span class="token-string">'page'</span>, <span class="token-string">'contact'</span>, [<span class="token-class">ContactController</span>::<span class="token-keyword">class</span>, <span class="token-string">'index'</span>]);</code></pre>
						<a href="/routing/wordpress-routes/" class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-ink hover:text-pollora-coral transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">WordPress routes <span aria-hidden="true">&rarr;</span></a>
					</div>
					<!-- Blade + Vite — 2 col -->
					<div data-reveal class="md:col-span-2 group bg-paper-2 rounded-[var(--radius-lg)] p-8 md:p-10 border border-rule hover:border-pollora-amber/30 transition-all duration-[var(--dur-short)]" style="--i:4">
						<div class="text-pollora-amber font-[var(--font-code)] text-sm tracking-wider uppercase font-semibold mb-4">Blade + Vite</div>
						<h3 class="font-[var(--font-display)] font-bold text-[var(--text-xl)] mb-3">WordPress data, Laravel syntax, instant reload</h3>
						<p class="text-ink-2 text-base">Themes in Blade with directives like <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">@posts</code>, <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">@title</code> and <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">@content</code>. Assets through Vite with hot reload and Tailwind CSS v4, no enqueue headaches.</p>
						<div class="flex flex-wrap gap-x-6">
							<a href="/guides/blade-templates-wordpress/" class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-ink hover:text-pollora-coral transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">Blade in WordPress <span aria-hidden="true">&rarr;</span></a>
							<a href="/theming/assets-vite/" class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-ink hover:text-pollora-coral transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">Assets and Vite <span aria-hidden="true">&rarr;</span></a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══ COMPARE ═══ -->
		<section id="compare" class="pl-deferred pb-24 md:pb-32">
