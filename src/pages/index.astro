						<div class="flex flex-wrap justify-center md:justify-start gap-5">
							<a href="/getting-started/installation/" class="inline-flex items-center gap-2.5 px-10 py-4 rounded-[var(--radius-md)] bg-gradient-pollora text-white text-lg font-bold hover:opacity-90 transition-opacity duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
								Get Started <span aria-hidden="true">&rarr;</span>
							</a>
							<a href="https://github.com/Pollora" target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 px-10 py-4 rounded-[var(--radius-md)] border border-[oklch(30%_0.01_290)] text-[var(--color-accent-ink)] text-lg font-semibold hover:border-neutral transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
								View on GitHub
							</a>
						</div>

						<!-- Issues -->
						<div class="mt-12 flex flex-col sm:flex-row items-center sm:items-start gap-4 p-5 rounded-[var(--radius-lg)] border border-code-surface bg-code-surface/40 text-left max-w-[34rem] mx-auto md:mx-0">
							<svg class="shrink-0 w-6 h-6 mt-0.5 text-pollora-coral" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/><path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Z"/></svg>
							<div class="text-center sm:text-left">
