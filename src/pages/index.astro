---
import polloraLogo from '../assets/pollora-logo.svg';
import mascotDeveloper from '../assets/mascot-developer.svg';
import mascotDocs from '../assets/mascot-documentation.svg';
import mascotGithub from '../assets/mascot-github.svg';
import videoPoster from '../assets/video-tour-poster.png';
import { Image } from 'astro:assets';
import '../styles/global.css';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// YouTube ID of the 1-minute beta launch tour
const youtubeId = 'Wk1VzPapqM8';
const tourEmbedUrl = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0&playsinline=1`;

const terminalSequence = JSON.parse(readFileSync(resolve('sources/terminal-sequence.json'), 'utf-8'));
const peekRaw = readFileSync(resolve('src/assets/mascot-peek.svg'), 'utf-8');
// Crop to top portion (eyes area) and clean up Inkscape metadata
const peekSvg = peekRaw
	.replace(/viewBox="[^"]*"/, 'viewBox="100 50 1900 850"')
	.replace(/<sodipodi:namedview[\s\S]*?\/>/g, '')
	.replace(/<\?xml[^>]*\?>/g, '')
	.replace(/xmlns:inkscape="[^"]*"/g, '')
	.replace(/xmlns:sodipodi="[^"]*"/g, '')
	.replace(/inkscape:[a-z-]+="[^"]*"/g, '')
	.replace(/sodipodi:[a-z-]+="[^"]*"/g, '')
	.replace(/id="svg82"/, 'id="mascot-peek"')
	.replace(/id="g82"/, 'id="pupil-2"')
	.replace(/id="g83"/, 'id="pupil-1"')
	.replace('display="block"', 'display="block" class="w-full h-auto"');
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Pollora — Laravel meets WordPress</title>
	<meta name="description" content="The modern PHP framework that blends Laravel's elegance with WordPress's power. PHP 8 attributes, Blade templates, auto-discovery — zero compromise." />
	<meta property="og:title" content="Pollora — Laravel meets WordPress" />
	<meta property="og:description" content="Modern PHP framework blending Laravel and WordPress. PHP 8 attributes, auto-discovery, Blade templates." />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://pollora.dev" />
	<link rel="icon" href="/favicon.ico" sizes="32x32" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
	<link rel="manifest" href="/site.webmanifest" />

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

</head>

<body class="bg-paper text-ink">

	<!-- ═══ NAV ═══ -->
	<nav x-data="{ open: false }" class="fixed top-0 left-0 right-0 z-[var(--z-sticky)] bg-paper/90 backdrop-blur-xl">
		<div class="gradient-bar h-[3px]"></div>
		<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)] h-18 flex items-center justify-between">
			<a href="/" class="flex items-center gap-2" aria-label="Pollora home">
				<img src={polloraLogo.src} alt="Pollora" class="h-9 w-auto" width="173" height="70" />
			</a>
			<div class="hidden md:flex items-center gap-9 font-[var(--font-body)] text-[0.95rem] font-medium text-ink-2">
				<a href="/getting-started/installation/" class="hover:text-ink transition-colors duration-[var(--dur-micro)]">Docs</a>
				<a href="#ecosystem" class="hover:text-ink transition-colors duration-[var(--dur-micro)]">Ecosystem</a>
				<a href="#nectar" class="hover:text-ink transition-colors duration-[var(--dur-micro)]">Nectar AI</a>
				<a href="https://github.com/Pollora" target="_blank" rel="noopener" class="hover:text-ink transition-colors duration-[var(--dur-micro)]">GitHub</a>
			</div>
			<a href="/getting-started/installation/" class="hidden md:inline-flex items-center gap-2 px-6 py-2.5 rounded-[var(--radius-pill)] bg-gradient-pollora text-white text-sm font-semibold hover:opacity-90 transition-opacity duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
				Get Started
			</a>
			<button @click="open = !open" class="md:hidden p-2 -mr-2" :aria-expanded="open" aria-label="Menu">
				<svg x-show="!open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
				<svg x-show="open" x-cloak width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
			</button>
		</div>
		<!-- Mobile menu -->
		<div x-show="open" x-cloak x-transition:enter="transition duration-200 ease-out" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition duration-150 ease-in" x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 -translate-y-2" class="md:hidden border-t border-rule bg-paper/95 backdrop-blur-xl">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)] py-6 flex flex-col gap-4 font-[var(--font-body)] text-base font-medium text-ink-2">
				<a href="/getting-started/installation/" @click="open = false" class="hover:text-ink">Docs</a>
				<a href="#ecosystem" @click="open = false" class="hover:text-ink">Ecosystem</a>
				<a href="#nectar" @click="open = false" class="hover:text-ink">Nectar AI</a>
				<a href="https://github.com/Pollora" target="_blank" rel="noopener" class="hover:text-ink">GitHub</a>
				<a href="/getting-started/installation/" class="inline-flex items-center justify-center gap-2 px-6 py-3 mt-2 rounded-[var(--radius-pill)] bg-gradient-pollora text-white text-sm font-semibold">
					Get Started
				</a>
			</div>
		</div>
	</nav>

	<main>

		<!-- ═══ HERO ═══ -->
		<section class="pt-36 pb-24 md:pt-44 md:pb-32 relative">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)]">
				<div class="grid md:grid-cols-[1.2fr_1fr] gap-12 md:gap-20 items-start">
					<div data-reveal class="" style="--i:0">
						<div class="flex flex-wrap items-center gap-3 mb-5">
							<p class="text-base font-semibold font-[var(--font-code)] tracking-wider uppercase text-gradient">Laravel + WordPress</p>
							<a href="https://github.com/Pollora/framework/releases" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-3 py-1 rounded-[var(--radius-pill)] border border-rule bg-paper-2 text-sm font-semibold font-[var(--font-code)] text-ink-2 hover:border-pollora-coral/40 hover:text-ink transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
								<span class="w-2 h-2 rounded-full bg-pollora-coral" aria-hidden="true"></span>
								v13.32.0-beta.2
							</a>
						</div>
						<h1 class="font-[var(--font-display)] font-bold text-[clamp(3rem,4vw+0.5rem,5.5rem)] leading-[1.05] tracking-tight text-ink mb-8" style="overflow-wrap:anywhere;min-width:0">
							Modern PHP,<br /><span class="text-gradient">zero compromise.</span>
						</h1>
						<p class="text-lg text-ink-2 max-w-[50ch] leading-relaxed mb-12">
							Build WordPress sites with Laravel's elegance. PHP 8 attributes, Blade templates, auto-discovery, and a full ecosystem of packages.
						</p>
						<div class="flex flex-wrap gap-4">
							<a href="/getting-started/installation/" class="inline-flex items-center gap-2.5 px-8 py-3.5 rounded-[var(--radius-md)] bg-gradient-pollora text-white text-lg font-semibold hover:opacity-90 transition-opacity duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
								Get Started <span aria-hidden="true">&rarr;</span>
							</a>
							<a href="https://github.com/Pollora" target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 px-8 py-3.5 rounded-[var(--radius-md)] border-2 border-rule text-ink text-lg font-semibold hover:border-pollora-coral/40 transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]">
								View on GitHub
							</a>
						</div>
						<button type="button" x-data @click="$store.tour.show()" class="group mt-8 inline-flex items-center gap-3 text-base font-semibold text-ink-2 hover:text-ink transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-focus)] rounded-[var(--radius-pill)]">
							<span class="grid place-items-center w-11 h-11 rounded-full bg-gradient-pollora text-white shadow-[0_0_20px_rgba(255,83,52,0.35)] group-hover:scale-110 transition-transform duration-[var(--dur-short)]"><svg class="w-5 h-5 translate-x-[8%]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.9-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z"/></svg></span>
							Watch the 1-min tour
							<span class="font-[var(--font-code)] text-sm font-normal text-muted">1:06</span>
						</button>
					</div>
					<div data-reveal class="rounded-[var(--radius-lg)] overflow-hidden shadow-2xl shadow-pollora-dark/10" style="--i:1">
						<div class="bg-code-bg p-6 md:p-8 pb-24 md:pb-28 font-[var(--font-code)] text-[0.9rem] md:text-base leading-relaxed">
							<div class="flex items-center gap-2 mb-6">
								<span class="w-3 h-3 rounded-full bg-pollora-pink"></span>
								<span class="w-3 h-3 rounded-full bg-pollora-amber"></span>
								<span class="w-3 h-3 rounded-full bg-pollora-teal"></span>
								<span class="ml-4 text-sm text-muted font-[var(--font-body)]">Book.php</span>
							</div>
							<pre><code><span class="token-keyword">use</span> <span class="token-class">Pollora\Attributes\PostType</span>;
<span class="token-keyword">use</span> <span class="token-class">Pollora\Attributes\ShowInRest</span>;

<span class="token-attribute">#[PostType('book')]</span>
<span class="token-attribute">#[HasArchive]</span>
<span class="token-attribute">#[Supports(['title', 'editor', 'thumbnail'])]</span>
<span class="token-attribute">#[ShowInRest]</span>
<span class="token-keyword">class</span> <span class="token-class">Book</span> <span class="token-punctuation">&#123;&#125;</span>

<span class="token-comment">// That's it. Auto-discovered, registered, ready.</span></code></pre>
						</div>
					</div>
				</div>
			</div>

			<!-- Mascot peek — absolute, bottom-right of hero -->
			<div x-data="polloraPeek()" @mousemove.window="track($event)" class="absolute bottom-0 right-0 z-10 pointer-events-none w-full" aria-hidden="true">
				<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)]">
					<div class="grid md:grid-cols-[1.2fr_1fr]">
						<div></div>
						<div class="flex justify-end">
							<div class="w-80 md:w-120 lg:w-140">
								<Fragment set:html={peekSvg} />
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══ VIDEO TOUR ═══ -->
		<section id="tour" class="py-24 md:py-32 bg-code-bg relative overflow-hidden">
			<div class="absolute inset-0 opacity-[0.08]" style="background: radial-gradient(ellipse at 50% 0%, #ff5334, transparent 65%)"></div>
			<div class="max-w-5xl mx-auto px-[clamp(1rem,4vw,2rem)] relative">
				<div data-reveal class="text-center mb-12" style="--i:0">
					<p class="text-base font-semibold font-[var(--font-code)] tracking-wider uppercase text-gradient mb-5">Public beta</p>
					<h2 class="font-[var(--font-display)] font-bold text-[clamp(2rem,3.5vw+0.5rem,3rem)] tracking-tight text-[var(--color-accent-ink)] mb-5">Pollora in <span class="text-gradient">60 seconds</span></h2>
					<p class="text-neutral text-lg max-w-[52ch] mx-auto">From one install command to your first post type — a quick tour of what changes when WordPress meets Laravel.</p>
				</div>
				<div data-reveal style="--i:1">
					<div x-data="{ playing: false }" class="relative aspect-video rounded-[var(--radius-lg)] overflow-hidden bg-black shadow-2xl shadow-black/40 ring-1 ring-white/10">
						<button type="button" x-show="!playing" @click="playing = true" class="group absolute inset-0 w-full h-full focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[var(--color-focus)]" aria-label="Play the Pollora 1-minute tour video">
							<Image src={videoPoster} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 1024px, 100vw" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" />
							<span class="absolute inset-0 bg-black/15 group-hover:bg-black/0 transition-colors duration-[var(--dur-short)]"></span>
							<span class="absolute inset-0 grid place-items-center">
								<span class="grid place-items-center w-18 h-18 md:w-24 md:h-24 rounded-full bg-gradient-pollora text-white shadow-[0_0_40px_rgba(255,83,52,0.55)] group-hover:scale-110 transition-transform duration-[var(--dur-short)]"><svg class="w-[40%] h-[40%] translate-x-[8%]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.9-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z"/></svg></span>
							</span>
							<span class="absolute bottom-3 right-3 md:bottom-4 md:right-4 px-2.5 py-1 rounded-[var(--radius-sm)] bg-black/70 text-white text-sm font-[var(--font-code)]">1:06</span>
						</button>
						<template x-if="playing">
							<iframe src={tourEmbedUrl} title="Pollora in 60 seconds" class="absolute inset-0 w-full h-full" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
						</template>
					</div>
				</div>
			</div>
		</section>

		<!-- ═══ INSTALL ═══ -->
		<section class="py-24 md:py-32 bg-paper-2">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)]">
				<div data-reveal class="max-w-3xl mx-auto text-center mb-14" style="--i:0">
					<h2 class="font-[var(--font-display)] font-bold text-[clamp(2rem,3.5vw+0.5rem,3rem)] tracking-tight mb-5">Up and running in <span class="text-gradient">one command</span></h2>
					<p class="text-ink-2 text-lg">Install the CLI, scaffold a project, start building. WordPress + Laravel, ready in under two minutes.</p>
				</div>
				<div data-reveal class="max-w-3xl mx-auto relative" style="--i:1">
					<div x-data="terminalAnim()" class="bg-code-bg rounded-[var(--radius-lg)] shadow-2xl shadow-pollora-dark/10 overflow-hidden">
						<!-- Title bar -->
						<div class="flex items-center gap-2 px-5 py-3.5 border-b border-code-surface">
							<span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
							<span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
							<span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
							<span class="ml-3 text-sm text-muted font-[var(--font-body)]">Terminal</span>
						</div>
						<!-- Terminal content -->
						<div x-ref="scroll" class="terminal-scroll px-5 md:px-7 py-5 text-[0.72rem] md:text-[0.82rem] leading-[1.6] overflow-y-auto" style="height: 420px; max-height: 55vh; font-family: 'JetBrains Mono', ui-monospace, monospace;">
							<template x-for="line in lines" :key="line.id">
								<div :class="line.cls" x-html="line.html" class="whitespace-pre"></div>
							</template>
						</div>
					</div>
					<img src={mascotDeveloper.src} alt="Pollora mascot" class="hidden md:block absolute -bottom-12 -right-16 lg:-right-24 w-44 lg:w-56 pointer-events-none drop-shadow-[0_0_20px_rgba(255,83,52,0.2)]" width="224" height="224" loading="lazy" />
				</div>
			</div>
		</section>

		<!-- ═══ FEATURES — Bento grid ═══ -->
		<section class="py-24 md:py-32">
			<div class="max-w-7xl mx-auto px-[clamp(1rem,4vw,2rem)]">
				<div data-reveal class="mb-16" style="--i:0">
					<h2 class="font-[var(--font-display)] font-bold text-[clamp(2rem,3.5vw+0.5rem,3rem)] tracking-tight mb-5">Built for the <span class="text-gradient">modern PHP developer</span></h2>
					<p class="text-ink-2 text-lg max-w-[55ch]">Everything you need to build WordPress sites with the tooling you already know and love.</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-6 gap-5">
					<!-- PHP 8 Attributes — 4 col -->
					<div data-reveal class="md:col-span-4 group bg-paper-2 rounded-[var(--radius-lg)] p-8 md:p-10 border border-rule hover:border-pollora-coral/30 transition-all duration-[var(--dur-short)]" style="--i:1">
						<div class="text-gradient font-[var(--font-code)] text-sm tracking-wider uppercase font-semibold mb-4">PHP 8 Attributes</div>
						<h3 class="font-[var(--font-display)] font-bold text-[var(--text-xl)] mb-3">Declare, don't register</h3>
						<p class="text-ink-2 text-base mb-6 max-w-[48ch]">Post types, taxonomies, hooks, REST endpoints, AJAX handlers, WP-CLI commands, schedules, AI abilities — all defined with PHP 8 attributes. No more <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">register_post_type()</code> calls.</p>
						<pre class="bg-code-bg rounded-[var(--radius-md)] p-5 text-[0.85rem] md:text-[0.9rem] font-[var(--font-code)] overflow-x-auto"><code><span class="token-attribute">#[PostType('product')]</span>
<span class="token-attribute">#[HasArchive]</span>
<span class="token-attribute">#[ShowInRest]</span>
<span class="token-keyword">class</span> <span class="token-class">Product</span> <span class="token-punctuation">&#123;&#125;</span></code></pre>
					</div>
					<!-- Auto-Discovery — 2 col -->
					<div data-reveal class="md:col-span-2 group bg-paper-2 rounded-[var(--radius-lg)] p-8 md:p-10 border border-rule hover:border-pollora-teal/30 transition-all duration-[var(--dur-short)]" style="--i:2">
						<div class="text-pollora-teal font-[var(--font-code)] text-sm tracking-wider uppercase font-semibold mb-4">Auto-Discovery</div>
						<h3 class="font-[var(--font-display)] font-bold text-[var(--text-xl)] mb-3">Write it, it works</h3>
						<p class="text-ink-2 text-base">No manual registration. Pollora scans your codebase and registers everything automatically. Convention over configuration.</p>
					</div>
					<!-- Blade Templates — 3 col -->
					<div data-reveal class="md:col-span-3 group bg-paper-2 rounded-[var(--radius-lg)] p-8 md:p-10 border border-rule hover:border-pollora-amber/30 transition-all duration-[var(--dur-short)]" style="--i:3">
						<div class="text-pollora-amber font-[var(--font-code)] text-sm tracking-wider uppercase font-semibold mb-4">Blade Templates</div>
						<h3 class="font-[var(--font-display)] font-bold text-[var(--text-xl)] mb-3">WordPress data, Laravel syntax</h3>
						<p class="text-ink-2 text-base">Replace PHP template files with Blade. Use directives like <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">@posts</code>, <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">@title</code>, <code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">@content</code> for clean, readable templates.</p>
					</div>
					<!-- Hybrid Routing — 3 col -->
					<div data-reveal class="md:col-span-3 group bg-paper-2 rounded-[var(--radius-lg)] p-8 md:p-10 border border-rule hover:border-pollora-pink/30 transition-all duration-[var(--dur-short)]" style="--i:4">
						<div class="text-pollora-pink font-[var(--font-code)] text-sm tracking-wider uppercase font-semibold mb-4">Hybrid Routing</div>
						<h3 class="font-[var(--font-display)] font-bold text-[var(--text-xl)] mb-3">Laravel routes + WordPress fallback</h3>
						<p class="text-ink-2 text-base mb-6"><code class="font-[var(--font-code)] text-[0.85em] bg-paper-3 px-1.5 py-0.5 rounded-[var(--radius-sm)]">Route::wp()</code> maps WordPress conditions to controllers. Custom routes take priority; the template hierarchy handles the rest.</p>
						<pre class="bg-code-bg rounded-[var(--radius-md)] p-5 text-[0.85rem] md:text-[0.9rem] font-[var(--font-code)] overflow-x-auto"><code><span class="token-class">Route</span>::<span class="token-function">wp</span>(<span class="token-string">'single'</span>, [<span class="token-class">PostController</span>::<span class="token-keyword">class</span>, <span class="token-string">'show'</span>]);
<span class="token-class">Route</span>::<span class="token-function">wp</span>(<span class="token-string">'page'</span>, <span class="token-string">'contact'</span>, [<span class="token-class">ContactController</span>::<span class="token-keyword">class</span>, <span class="token-string">'index'</span>]);</code></pre>
					</div>
					<!-- Vite + Tailwind — 3 col -->
					<div data-reveal class="md:col-span-3 group bg-paper-2 rounded-[var(--radius-lg)] p-8 md:p-10 border border-rule hover:border-pollora-orange/30 transition-all duration-[var(--dur-short)]" style="--i:5">
						<div class="text-pollora-orange font-[var(--font-code)] text-sm tracking-wider uppercase font-semibold mb-4">Vite + Tailwind</div>
						<h3 class="font-[var(--font-display)] font-bold text-[var(--text-xl)] mb-3">Modern asset pipeline</h3>
						<p class="text-ink-2 text-base">Vite with HMR, Tailwind CSS v4, and the Asset facade for script and style registration. No more enqueue headaches.</p>
					</div>
					<!-- Type Safety — 3 col -->
					<div data-reveal class="md:col-span-3 group bg-paper-2 rounded-[var(--radius-lg)] p-8 md:p-10 border border-rule hover:border-pollora-red/30 transition-all duration-[var(--dur-short)]" style="--i:6">
