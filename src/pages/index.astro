	<!-- ═══ VIDEO MODAL ═══ -->
	<div x-data x-show="$store.tour.open" x-cloak x-transition.opacity @keydown.escape.window="$store.tour.hide()" @click.self="$store.tour.hide()" class="fixed inset-0 z-[1000] flex items-center justify-center p-4 md:p-10 bg-black/85 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Pollora in 60 seconds">
		<div class="relative w-full max-w-5xl">
			<button type="button" x-ref="close" @click="$store.tour.hide()" class="absolute -top-12 right-0 grid place-items-center w-10 h-10 rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors duration-[var(--dur-micro)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]" aria-label="Close video">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
			</button>
			<div class="relative aspect-video rounded-[var(--radius-lg)] overflow-hidden bg-black shadow-2xl">
				<template x-if="$store.tour.open">
					<iframe src={tourEmbedUrl} title="Pollora in 60 seconds" class="absolute inset-0 w-full h-full" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
				</template>
			</div>
		</div>
