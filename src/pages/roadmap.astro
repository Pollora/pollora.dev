---
// Roadmap: where Pollora is going, in three undated horizons.
// The source is the roadmap document kept with the project; keep this page in step when it moves.
// Line styles carry the horizon everywhere on the page: solid = exists, short term = filled,
// mid term = dashed, long term = dotted (the package map's legend spells it out).
import SiteLayout from '../layouts/SiteLayout.astro';

import release from '../data/release.json';
const FROM_VERSION = release.version;

type Horizon = { id: string; num: string; label: string; when: string; status: string; title: string; intro: string; accent: string };

const horizons: Horizon[] = [
	{
		id: 'short-term',
		num: '01',
		label: 'Short term',
		when: 'The next 13.x releases',
		status: 'Foundations shipped in 13.36',
		title: 'Foundations, and the gaps you notice first',
		intro: 'Discovery and attributes left the framework in 13.36: the rest of the roadmap builds on them. Next, Pollora fills three everyday gaps: block variations and styles, menus and widgets.',
		accent: '#fb196d',
	},
	{
		id: 'mid-term',
		num: '02',
		label: 'Mid term',
		when: 'Once the foundations are out',
		status: 'Planned, order may change',
		title: 'WordPress integrations, one package each',
		intro: 'With discovery and attributes standing alone, each feature that mostly talks to WordPress can leave the framework in turn: scheduled tasks, REST routes and WP-CLI commands left in 13.36, then typed meta, roles, Block Bindings and assets in 13.36.1. Blade blocks and patterns are next. In parallel, Pollora covers new WordPress APIs, always in two forms: a fluent API and an attribute.',
		accent: '#ff8c12',
	},
	{
		id: 'long-term',
		num: '03',
		label: 'Long term',
		when: 'Pollora without Laravel',
		status: 'Direction, under study',
		title: 'Pollora in a classic WordPress or a Bedrock',
		intro: 'In time, Pollora ships as a mu-plugin that embeds the framework. Each port picks its adapter from what is present: Laravel in a Pollora application, native WordPress elsewhere. Your code stays the same.',
		accent: '#49c7b9',
	},
];
const [short, mid, long] = horizons;

const principles = [
	{ title: 'One package per job', text: 'Discovery, attributes and each WordPress integration become packages you can install on their own.' },
	{ title: 'The framework assembles', text: '<code>pollora/framework</code> keeps what belongs to Laravel (routing, Eloquent, auth, queues) and wires the packages together.' },
	{ title: 'Same code everywhere', text: 'A <code>#[PostType]</code> or an <code>#[Action]</code> reads the same in a Laravel app, a classic WordPress or a Bedrock.' },
	{ title: 'Third-party plugins stay outside', text: 'ACF or Meta Box support comes as a companion package, never inside the framework.' },
];

const attributeNames = ['#[PostType]', '#[Taxonomy]', '#[Action]', '#[Filter]', '#[Meta]', '#[Role]', '#[Schedule]', '#[WpRestRoute]', '#[Ajax]', '#[Ability]', '#[BlockBinding]', '#[SkipDiscovery]', 'WP-CLI attributes'];

type Gap = { title: string; href?: string; today: string; planned: string[] };
const gaps: Gap[] = [
	{
		title: 'Block variations',
		href: '/blocks/gutenberg-blocks/',
		today: 'Nothing dedicated',
		planned: ['A fluent API and an attribute, for theme blocks and <code>core/*</code> blocks alike'],
	},
	{
		title: 'Block styles',
		href: '/blocks/gutenberg-blocks/',
		today: 'Nothing dedicated',
		planned: ['A fluent API and an attribute, the stylesheet served by Vite'],
	},
	{
		title: 'Block categories',
		today: 'Set in the configuration, undocumented',
		planned: ['Documented first, then a fluent API and an attribute'],
	},
	{
		title: 'Menus',
		href: '/theming/menus/',
		today: 'Locations in the theme configuration; rendering rules (<code>link_config</code>, <code>item_config</code>, <code>submenu_config</code>) passed to <code>wp_nav_menu()</code>',
		planned: [
			'Locations declared with a fluent API and an attribute, like post types',
			'A Blade component that renders a menu, keeping the existing class and attribute rules',
			'The docs page listed for what it covers: navigation menus, not admin menus',
		],
	},
	{
		title: 'Widgets and widget areas',
		today: 'Areas declared in the theme’s <code>config/sidebars.php</code>, no other API',
		planned: ['Widget areas with a fluent API and an attribute', 'A widget as a class with an attribute, rendered in Blade'],
	},
];

type Extraction = { feature: string; pkg: string; solve: string; href: string; needs?: string };
const extractions: Extraction[] = [
	{ feature: 'Blade blocks & patterns', pkg: 'pollora/blocks', solve: 'Standalone Blade (<code>illuminate/view</code> alone); the editor runtime and <code>&lt;InnerBlocks /&gt;</code> unchanged.', href: '/blocks/patterns/' },
];

const newApis = [
	{ title: 'Allowed blocks per post type', planned: 'Restrict or hide blocks, <code>core/*</code> included, per post type' },
	{ title: 'Block Hooks', planned: 'Insert a block automatically before, after or inside another' },
	{ title: 'Admin pages & settings', planned: 'Pages and settings declared as attributes, with fields typed like meta' },
	{ title: 'Image sizes', planned: 'A fluent API and an attribute instead of <code>config/images.php</code>, then an image manipulation module' },
	{ title: 'Post statuses', planned: 'Custom statuses declared the way post types are' },
	{ title: 'Shortcodes', planned: 'A class with an attribute, rendered in Blade' },
	{ title: 'Dashboard widgets', planned: 'A class with an attribute, rendered in Blade' },
	{ title: 'Admin notices', planned: 'A fluent API, targeted by screen and by capability' },
];

const muPlugin = [
	'The framework loads as it is: only the adapters change with the environment.',
	'Discovery and attributes plug into the active theme and plugins.',
	'Blade stays available for blocks and patterns.',
	'Install by dropping the mu-plugin into a classic WordPress, or with Composer in a Bedrock.',
];

const ports = [
	{ port: 'Cache', detail: 'discovery, results', laravel: 'Laravel cache', wordpress: 'Transients or the WordPress object cache' },
	{ port: 'Async actions', detail: 'deferred hooks', laravel: 'Laravel queue', wordpress: 'Action Scheduler, else WP-Cron' },
	{ port: 'Logs', detail: 'notices, errors', laravel: 'Laravel logs', wordpress: 'WordPress <code>debug.log</code>' },
	{ port: 'Configuration', detail: 'settings', laravel: 'The <code>config/</code> folder', wordpress: 'Theme configuration and WordPress filters' },
	{ port: 'Commands', detail: 'console', laravel: 'Artisan', wordpress: 'WP-CLI' },
];

const laravelOnly = [
	{ label: 'Laravel routing', code: 'Route::wp()' },
	{ label: 'Eloquent', code: 'pollora/colt' },
	{ label: 'Authentication' },
	{ label: 'Modules' },
];

// Package map: `stage` drives the border style, see the legend
type Stage = 'exists' | 'short' | 'mid' | 'long';
const wpPackages: { name: string; stage: Stage }[] = [
	{ name: 'pollora/hook', stage: 'exists' },
	{ name: 'pollora/ajax', stage: 'exists' },
	{ name: 'pollora/abilities', stage: 'exists' },
	{ name: 'pollora/option', stage: 'exists' },
	{ name: 'pollora/meta', stage: 'exists' },
	{ name: 'pollora/block-bindings', stage: 'exists' },
	{ name: 'pollora/roles', stage: 'exists' },
	{ name: 'pollora/schedule', stage: 'exists' },
	{ name: 'pollora/wp-rest', stage: 'exists' },
	{ name: 'pollora/wp-cli', stage: 'exists' },
	{ name: 'pollora/assets', stage: 'exists' },
	{ name: 'pollora/blocks', stage: 'mid' },
];
const legend: { stage: Stage; label: string }[] = [
	{ stage: 'exists', label: 'Exists today' },
	{ stage: 'short', label: 'Short term' },
	{ stage: 'mid', label: 'Mid term' },
	{ stage: 'long', label: 'Long term' },
];

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: 'Pollora roadmap',
	url: 'https://pollora.dev/roadmap/',
	description: 'Where Pollora is going: reusable packages, fuller WordPress coverage, then Pollora without Laravel.',
	isPartOf: { '@type': 'WebSite', name: 'Pollora', url: 'https://pollora.dev/' },
};
---

<SiteLayout
	title="Pollora roadmap: packages, WordPress coverage, and beyond Laravel"
	description="Where Pollora is going: discovery and attributes as standalone packages, block variations, menus and widgets, each WordPress integration in its own package, then Pollora as a mu-plugin in classic WordPress and Bedrock."
	socialDescription="Reusable packages, fuller WordPress coverage, then Pollora without Laravel: the roadmap in three horizons."
	structuredData={structuredData}
>
	<!-- ─── Hero ──────────────────────────────────────────────────────── -->
	<header class="rm-hero">
		<div class="pl-container">
			<p class="pl-kicker"><span class="pl-kicker__dot" aria-hidden="true"></span>Roadmap</p>
			<h1 class="pl-index-title rm-hero__title">Where Pollora <span class="text-gradient">is going</span></h1>
			<p class="pl-index-lede">
				Pollora is splitting into packages you can use on their own, filling in what it still misses of WordPress
				(blocks, menus, widgets), and heading toward a Pollora that runs without Laravel, in a classic WordPress or a Bedrock.
			</p>

			<!-- The three horizons on one track, from the current release -->
			<ol class="rm-track" role="list" aria-label="Three horizons">
				<li class="rm-track__start" aria-hidden="true">
					<span class="rm-track__pin"></span>
					<span class="rm-track__here">You are here</span>
					<span class="rm-track__version">v{FROM_VERSION}</span>
				</li>
				{horizons.map((h, i) => (
					<li class={`rm-track__stop rm-track__stop--${i + 1}`} style={`--accent:${h.accent}`}>
						<a href={`#${h.id}`} class="rm-stop">
							<span class="rm-stop__num">{h.num}</span>
							<span class="rm-stop__label">{h.label}</span>
							<span class="rm-stop__title">{h.title}</span>
							<span class="rm-stop__status">{h.status}</span>
						</a>
					</li>
				))}
			</ol>
			<p class="rm-hero__note">
				<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 5.5V10l3 2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
				The horizons are not dated: they set an order of priority, not a calendar.
			</p>
		</div>
	</header>

	<!-- Sticky progress through the horizons; the active one is lit by the script below -->
	<nav class="rm-sticky" aria-label="Roadmap sections" data-rm-sticky>
		<div class="pl-container rm-sticky__inner">
			<a href="#vision" data-rm-link="vision">Vision</a>
			{horizons.map((h) => (
				<a href={`#${h.id}`} data-rm-link={h.id} style={`--accent:${h.accent}`}><span class="rm-sticky__dot" aria-hidden="true"></span>{h.label}</a>
			))}
			<a href="#package-map" data-rm-link="package-map">Package map</a>
		</div>
		<div class="rm-sticky__progress" aria-hidden="true"><span data-rm-progress></span></div>
	</nav>

	<!-- ─── Vision ────────────────────────────────────────────────────── -->
	<section id="vision" class="rm-section" aria-labelledby="vision-title" data-rm-section>
		<div class="pl-container">
			<div class="pl-chapter__head">
				<div>
					<p class="pl-chapter__num text-accent">The vision</p>
					<h2 id="vision-title" class="pl-chapter__title">Building blocks, not a monolith</h2>
				</div>
				<p class="pl-chapter__intro">
					Today most of Pollora lives in one package, <code>pollora/framework</code>, which assumes Laravel. Some pieces are already out:
					<code>pollora/hook</code> works in a classic WordPress plugin or theme, and <code>pollora/helper-overrider</code> has no
					Laravel dependency at all. The goal is to make that the rule.
				</p>
			</div>
			<ol class="rm-principles" role="list">
				{principles.map((p, i) => (
					<li data-reveal style={`--i:${i}`}>
						<span class="rm-principles__num">0{i + 1}</span>
						<h3>{p.title}</h3>
						<p set:html={p.text} />
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- ─── Short term ────────────────────────────────────────────────── -->
	<section id={short.id} class="rm-section rm-horizon" style={`--accent:${short.accent}`} aria-labelledby={`${short.id}-title`} data-rm-section>
		<div class="pl-container">
			<div class="rm-horizon__head">
				<p class="rm-horizon__eyebrow"><span class="rm-horizon__num">{short.num}</span>{short.label} · {short.when}<span class="rm-status rm-status--short">{short.status}</span></p>
				<h2 id={`${short.id}-title`} class="pl-chapter__title">{short.title}</h2>
				<p class="pl-chapter__intro">{short.intro}</p>
			</div>

			<h3 class="rm-subhead">The foundations <span>Shipped in 13.36, everything else depends on these two</span></h3>
			<div class="rm-foundations">
				<article class="rm-card rm-card--foundation" data-reveal style="--i:0">
					<p class="rm-card__pkg">pollora/discovery</p>
					<h4 class="rm-card__title">Discovery is a package</h4>
					<p class="rm-card__text">
						Discovery scans themes, plugins and modules for classes that carry attributes. It now lives in <code>pollora/discovery</code>, which the framework requires,
						and its contracts (<code>Pollora\Discovery\Domain\Contracts\*</code>) are a stable public API.
					</p>
					<ul class="rm-checks" role="list">
						<li>Runs without Laravel’s application: <code>new DiscoveryEngine()</code> takes no argument, and any PSR-16 cache stores the scans.</li>
						<li>The environment plugs in through two contracts: one builds the classes discovery needs (Laravel’s container in Pollora), the other adds its discoveries before each run.</li>
						<li><code>discovery:run</code> and <code>discovery:clear</code> stay in the framework, with the Laravel adapters.</li>
					</ul>
					<a class="rm-card__link" href="/core-concepts/auto-discovery/">How discovery works <span aria-hidden="true">&rarr;</span></a>
				</article>
				<article class="rm-card rm-card--foundation" data-reveal style="--i:1">
					<p class="rm-card__pkg">pollora/attributes</p>
					<h4 class="rm-card__title">The attributes are a package</h4>
					<p class="rm-card__text">
						Every attribute declaration lives in <code>pollora/attributes</code>, which reaches neither Laravel nor the framework. Processing each attribute stays in the package of its feature.
					</p>
					<ul class="rm-chips" role="list" aria-label="Attributes in pollora/attributes">
						{attributeNames.map((name) => <li><code>{name}</code></li>)}
					</ul>
					<p class="rm-card__payoff">
						<strong>What it unlocks:</strong> a plugin can declare its attributes without installing the framework, and an IDE or a static analyser can read them on their own.
					</p>
				</article>
			</div>

			<h3 class="rm-subhead">The everyday gaps <span>Blocks, menus and widgets</span></h3>
			<div class="rm-gaps">
				{gaps.map((gap, i) => (
					<article class="rm-gap" data-reveal style={`--i:${i % 3}`}>
						<h4 class="rm-gap__title">
							{gap.href ? <a href={gap.href}>{gap.title}</a> : gap.title}
						</h4>
						<div class="rm-gap__today">
							<span class="rm-gap__tag">Today</span>
							<p set:html={gap.today} />
						</div>
						<div class="rm-gap__planned">
							<span class="rm-gap__tag">Planned</span>
							<ul role="list">
								{gap.planned.map((item) => <li set:html={item} />)}
							</ul>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- ─── Mid term ──────────────────────────────────────────────────── -->
	<section id={mid.id} class="rm-section rm-horizon" style={`--accent:${mid.accent}`} aria-labelledby={`${mid.id}-title`} data-rm-section>
		<div class="pl-container">
			<div class="rm-horizon__head">
				<p class="rm-horizon__eyebrow"><span class="rm-horizon__num">{mid.num}</span>{mid.label} · {mid.when}<span class="rm-status rm-status--mid">{mid.status}</span></p>
				<h2 id={`${mid.id}-title`} class="pl-chapter__title">{mid.title}</h2>
				<p class="pl-chapter__intro">{mid.intro}</p>
			</div>

			<h3 class="rm-subhead">Next to leave the framework <span>What it has to solve first</span></h3>
			<div class="rm-extract">
				{extractions.map((e, i) => (
					<article class="rm-extract__item" data-reveal style={`--i:${i % 4}`}>
						<p class="rm-extract__from">{e.feature}</p>
						<p class="rm-extract__pkg"><span aria-hidden="true">&rarr;</span> {e.pkg}</p>
						<p class="rm-extract__solve" set:html={e.solve} />
						{e.needs && <p class="rm-extract__needs">Needs <code>{e.needs}</code></p>}
						<a href={e.href} class="rm-extract__docs" aria-label={`${e.feature} docs`}>Docs <span aria-hidden="true">&rarr;</span></a>
					</article>
				))}
			</div>

			<h3 class="rm-subhead">New WordPress APIs <span>Nothing dedicated today; each gets a fluent API and an attribute</span></h3>
			<ul class="rm-apis" role="list">
				{newApis.map((api, i) => (
					<li data-reveal style={`--i:${i % 4}`}>
						<h4>{api.title}</h4>
						<p set:html={api.planned} />
					</li>
				))}
			</ul>

			<aside class="rm-companion" data-reveal>
				<p class="rm-companion__kicker">Companion packages</p>
				<p class="rm-companion__text">
					Third-party plugin integrations live outside the framework. The first one is out: <strong>Meta Box</strong>, with
					<a href="https://github.com/Pollora/metabox-bridge"><code>pollora/metabox-bridge</code></a> (v1.0.0), which connects Meta Box custom tables to migrations and Eloquent.
				</p>
			</aside>
		</div>
	</section>

	<!-- ─── Long term ─────────────────────────────────────────────────── -->
	<section id={long.id} class="rm-section rm-horizon rm-horizon--dark" style={`--accent:${long.accent}`} aria-labelledby={`${long.id}-title`} data-rm-section>
		<div class="pl-container">
			<div class="rm-horizon__head">
				<p class="rm-horizon__eyebrow"><span class="rm-horizon__num">{long.num}</span>{long.label} · {long.when}<span class="rm-status rm-status--long">{long.status}</span></p>
				<h2 id={`${long.id}-title`} class="pl-chapter__title">{long.title}</h2>
				<p class="pl-chapter__intro">{long.intro}</p>
			</div>

			<div class="rm-mu">
				<div>
					<h3 class="rm-subhead">A mu-plugin that embeds the framework</h3>
					<ul class="rm-checks rm-checks--dark" role="list">
						{muPlugin.map((item) => <li>{item}</li>)}
					</ul>
					<div class="rm-only">
						<p class="rm-only__label">Stays in Laravel applications</p>
						<ul role="list">
							{laravelOnly.map((item) => <li>{item.label}{item.code && <code>{item.code}</code>}</li>)}
						</ul>
					</div>
				</div>

				<!-- Ports and adapters: the switch lights the adapter each environment would use -->
				<div class="rm-ports" x-data="{ env: 'laravel' }">
					<div class="rm-ports__head">
						<p>Same port, the adapter that fits</p>
						<div class="rm-switch" role="radiogroup" aria-label="Environment">
							<button type="button" role="radio" :aria-checked="env === 'laravel'" aria-checked="true" @click="env = 'laravel'">Laravel app</button>
							<button type="button" role="radio" :aria-checked="env === 'wordpress'" aria-checked="false" @click="env = 'wordpress'">WordPress · Bedrock</button>
						</div>
					</div>
					<ul class="rm-ports__list" role="list" :data-env="env" data-env="laravel">
						{ports.map((p) => (
							<li class="rm-port">
								<span class="rm-port__side rm-port__side--laravel" set:html={p.laravel} />
								<span class="rm-port__plug">
									<strong>{p.port}</strong>
									<small>{p.detail}</small>
								</span>
								<span class="rm-port__side rm-port__side--wordpress" set:html={p.wordpress} />
							</li>
						))}
					</ul>
					<p class="rm-ports__foot">Your code calls the port. Which side answers depends on where Pollora runs.</p>
				</div>
			</div>

			<aside class="rm-announced">
				<p class="rm-announced__kicker">Already announced</p>
				<p>
					The <code>resources/blocks</code> folder is still read, with a warning, until <strong>Pollora v15</strong>.
					Move your blocks to <code>resources/views/blocks</code>.
				</p>
			</aside>
		</div>
	</section>

	<!-- ─── Package map ───────────────────────────────────────────────── -->
	<section id="package-map" class="rm-section" aria-labelledby="package-map-title" data-rm-section>
		<div class="pl-container">
			<div class="pl-chapter__head">
				<div>
					<p class="pl-chapter__num text-accent">Package map</p>
					<h2 id="package-map-title" class="pl-chapter__title">Everything rests on two packages</h2>
				</div>
				<p class="pl-chapter__intro">
					Discovery and attributes are the base. The WordPress packages build on them, and the framework assembles them, whether a Laravel
					application loads it or, in time, the mu-plugin.
				</p>
			</div>

			<figure class="rm-map">
				<div class="rm-map__layer rm-map__hosts">
					<div class="rm-map__box" data-stage="exists">
						<strong>Laravel application</strong>
						<span>Routing, Eloquent (colt), auth, modules</span>
					</div>
					<div class="rm-map__box" data-stage="long">
						<strong>Pollora mu-plugin</strong>
						<span>Classic WordPress or Bedrock, no Laravel</span>
					</div>
				</div>
				<div class="rm-map__links rm-map__links--two" aria-hidden="true"><span>loads</span><span>will embed</span></div>
				<div class="rm-map__layer">
					<div class="rm-map__box rm-map__box--wide" data-stage="exists">
						<strong>pollora/framework</strong>
						<span>Ports and adapters: Laravel when present, WordPress otherwise (Action Scheduler, transients, WP-CLI)</span>
					</div>
				</div>
				<div class="rm-map__links" aria-hidden="true"><span>assembles</span></div>
				<div class="rm-map__layer rm-map__group">
					<p class="rm-map__group-label">WordPress packages</p>
					<ul class="rm-map__grid" role="list">
						{wpPackages.map((p) => <li class="rm-map__chip" data-stage={p.stage}><code>{p.name}</code></li>)}
					</ul>
				</div>
				<div class="rm-map__links" aria-hidden="true"><span>build on</span></div>
				<div class="rm-map__layer rm-map__base">
					<div class="rm-map__box" data-stage="short">
						<strong>pollora/discovery</strong>
						<span>Finds the classes that carry attributes</span>
					</div>
					<div class="rm-map__box" data-stage="short">
						<strong>pollora/attributes</strong>
						<span>Attribute declarations, no dependencies</span>
					</div>
				</div>
				<figcaption>
					<ul class="rm-legend" role="list">
						{legend.map((l) => <li><span class="rm-legend__swatch" data-stage={l.stage}></span>{l.label}</li>)}
					</ul>
					<p>
						<code>pollora/helper-overrider</code>, already standalone, stays apart: it lets Laravel’s and WordPress’s <code>__()</code> functions live side by side.
					</p>
				</figcaption>
			</figure>
		</div>
	</section>

	<!-- ─── Contribute ────────────────────────────────────────────────── -->
	<section class="pl-container pb-20 md:pb-28">
		<div class="rm-cta">
