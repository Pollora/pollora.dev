---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import BlogIndex from '../../../components/blog/BlogIndex.astro';
import { categories, getPosts, type Category } from '../../../lib/blog';

export async function getStaticPaths() {
	return (Object.keys(categories) as Category[]).map((category) => ({ params: { category } }));
}

const category = Astro.params.category as Category;
const posts = (await getPosts()).filter((p) => p.data.category === category);
const { plural, intro } = categories[category];
---

<BlogLayout title={`${plural} · Pollora blog`} description={`${intro} From the blog of Pollora, the Laravel framework for WordPress.`}>
	<BlogIndex posts={posts} active={category} />
</BlogLayout>
