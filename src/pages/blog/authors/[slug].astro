---
// An author's page: who they are, their path, and the posts they wrote.
import { Image } from 'astro:assets';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import PostList from '../../../components/blog/PostList.astro';
import { authors, authorUrl, getPosts, type Author } from '../../../lib/blog';

export async function getStaticPaths() {
	return Object.entries(authors).map(([name, author]) => ({ params: { slug: author.slug }, props: { name, author } }));
}

interface Props {
	name: string;
	author: Author;
}

const { name, author } = Astro.props;
const posts = (await getPosts()).filter((p) => p.data.author === name);
const [first, ...last] = name.split(' ');
const url = new URL(authorUrl(author.slug), 'https://pollora.dev').href;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	url,
	mainEntity: {
		'@type': 'Person',
		name,
		description: author.bio,
		jobTitle: author.role,
		sameAs: author.links?.map((l) => l.href),
	},
};
---

<BlogLayout title={`${name} · Pollora blog`} description={author.bio ?? `Posts by ${name} on the Pollora blog.`} structuredData={structuredData}>
	<header class="pl-author-hero">
		<div class="pl-container">
			<a href="/blog/" class="pl-back">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
				All posts
			</a>

			<div class="pl-author-grid">
				<div class="pl-author-photo">
					<Image src={author.avatar} alt={`Portrait of ${name}`} width={480} height={480} loading="eager" />
				</div>

				<div>
					<p class="pl-kicker"><span class="pl-kicker__dot" aria-hidden="true"></span>Author</p>
					<h1 class="pl-author-name">{first} <span class="text-gradient">{last.join(' ')}</span></h1>
					{author.role && <p class="pl-author-role">{author.role}</p>}
					{author.bio && <p class="pl-author-bio">{author.bio}</p>}
					{author.quote && <p class="pl-author-quote">“{author.quote}”</p>}

					{author.links && (
						<ul class="pl-author-links" role="list">
							{author.links.map((l) => (
								<li>
									<a href={l.href} target="_blank" rel="noopener me" class="pl-author-link">
										{l.kind === 'github' && <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>}
										{l.kind === 'linkedin' && <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>}
										{l.kind === 'site' && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5c2.6 2.8 3.9 6 3.9 9.5s-1.3 6.7-3.9 9.5c-2.6-2.8-3.9-6-3.9-9.5s1.3-6.7 3.9-9.5Z"/></svg>}
										<span>{l.label}</span>
										<svg class="pl-author-link__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
									</a>
								</li>
							))}
						</ul>
					)}
				</div>
			</div>
		</div>
	</header>

	{author.timeline && (
		<section class="pl-container pl-author-section" aria-labelledby="path">
			<h2 id="path" class="pl-section-title">The path so far</h2>
			<ol class="pl-timeline" role="list">
				{author.timeline.map((step, i) => (
					<li class:list={['pl-timeline__item', i === author.timeline!.length - 1 && 'is-now']}>
						<span class="pl-timeline__year">{step.year}</span>
						<div class="pl-timeline__body">
							<h3 class="pl-timeline__title">
								{step.title}
								{step.place && <span class="pl-timeline__place">{step.place}</span>}
							</h3>
							<p>{step.text}</p>
						</div>
					</li>
				))}
			</ol>
		</section>
	)}

	{author.motto && (
		<section class="pl-motto" aria-label="Motto">
			<div class="gradient-bar h-[3px] absolute inset-x-0 top-0" aria-hidden="true"></div>
			<div class="pl-container">
				<p class="pl-motto__label">Working rule</p>
				<blockquote class="pl-motto__text">{author.motto}</blockquote>
			</div>
		</section>
	)}

	<section class="pl-container pl-author-section pb-24 md:pb-32" aria-labelledby="posts">
		<h2 id="posts" class="pl-section-title">Posts by {first} <span class="pl-section-count">{posts.length}</span></h2>
		<PostList posts={posts} />
	</section>
</BlogLayout>
