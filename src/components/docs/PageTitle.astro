---
import CopyPage from './CopyPage.astro';

// Same id as Starlight's PAGE_TITLE_ID: the "Overview" TOC entry links to it.
const PAGE_TITLE_ID = '_top';
const route = Astro.locals.starlightRoute;
const { title, description, template } = route.entry.data;
const hasMarkdown = template !== 'splash' && route.id !== '404';
---

<div class="pl-page-title">
	<div class="pl-title-row">
		<h1 id={PAGE_TITLE_ID}>{title}</h1>
		{hasMarkdown && <CopyPage />}
	</div>
	{description && <p class="pl-lead">{description}</p>}
</div>

<style>
	.pl-page-title {
		margin-top: 1.25rem;
	}

	.pl-title-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem 1.5rem;
	}

	/* The button sits on the first line of the title, and drops under it on phones */
	.pl-title-row > :global(pl-copy-page) {
		margin-top: 0.6rem;
	}

	@media (max-width: 40rem) {
		.pl-title-row {
			flex-direction: column;
		}

		.pl-title-row > :global(pl-copy-page) {
			margin-top: 0;
		}
	}

	h1 {
		font-family: var(--pl-font-display);
		font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.25rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
		overflow-wrap: anywhere;
		min-width: 0;
	}

	/* Short brand stroke under the title */
	h1::after {
		content: '';
		display: block;
		width: 3rem;
		height: 3px;
		margin-top: 1rem;
		border-radius: 3px;
		background: var(--pl-gradient);
	}

	.pl-lead {
		margin-top: 1rem;
		max-width: 60ch;
		font-size: var(--sl-text-lg);
		line-height: 1.55;
		color: var(--sl-color-gray-3);
	}
</style>
