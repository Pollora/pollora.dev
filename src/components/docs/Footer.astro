---
import Default from '@astrojs/starlight/components/Footer.astro';
import mascot from '../../assets/mascot-documentation.svg';
import { social } from '../../lib/site';

// The same destinations as the footer of the rest of the site (SiteLayout)
const site = [
	{ label: 'Home', href: '/' },
	{ label: 'Features', href: '/features/' },
	{ label: 'Blog', href: '/blog/' },
	{ label: 'Changelog', href: '/changelog/' },
	{ label: 'Press kit', href: '/press/' },
	{ label: 'GitHub', href: social.github, external: true },
	{ label: 'X', href: social.x, external: true },
];

const issueUrl = `https://github.com/Pollora/framework/issues/new?title=${encodeURIComponent(
	`Docs: ${Astro.locals.starlightRoute.entry.data.title}`
)}`;
---

<aside class="pl-help not-content print:hidden" aria-label="Documentation feedback">
	<img src={mascot.src} alt="" width="72" height="72" loading="lazy" decoding="async" />
	<div>
		<p class="pl-help-title">Something unclear or missing?</p>
		<p class="pl-help-body">
			<a href={issueUrl} target="_blank" rel="noopener" data-track="docs_feedback">Open an issue</a> on <a href="https://github.com/Pollora/framework">Pollora/framework</a>
			and we'll fix it.
		</p>
	</div>
</aside>

<Default />

<nav class="pl-site-footer print:hidden" aria-label="Pollora site">
	{site.map((l) => <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>)}
	<button type="button" data-consent-open>Cookie settings</button>
</nav>

<style>
	.pl-help {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: 4rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--pl-radius-md);
		background-color: var(--pl-surface);
	}

	img {
		flex-shrink: 0;
		width: 4.5rem;
		height: 4.5rem;
		transform: rotate(-6deg);
	}

	.pl-help-title {
		font-family: var(--pl-font-display);
		font-weight: 600;
		font-size: var(--sl-text-lg);
		line-height: 1.3;
		color: var(--sl-color-white);
	}

	.pl-help-body {
		margin-top: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.pl-help-body a {
		color: var(--sl-color-text-accent);
		font-weight: 500;
		text-decoration-color: color-mix(in oklch, var(--sl-color-accent) 40%, transparent);
		text-underline-offset: 0.2em;
	}

	.pl-help-body a:hover {
		text-decoration-color: var(--sl-color-accent);
	}

	.pl-site-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.5rem;
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline-light);
		font-size: var(--sl-text-sm);
	}

	.pl-site-footer a,
	.pl-site-footer button {
		border: 0;
		background: none;
		color: var(--sl-color-gray-3);
		font: inherit;
		text-decoration: none;
		cursor: pointer;
	}

	.pl-site-footer a:hover,
	.pl-site-footer button:hover {
		color: var(--sl-color-white);
	}

	@media (max-width: 30rem) {
		.pl-help {
			align-items: flex-start;
			gap: 1rem;
			padding: 1rem;
		}

		img {
			width: 3.25rem;
			height: 3.25rem;
		}
	}
</style>
