---
// "Watch what disappears": the book post type written for WordPress, then for Pollora, as one piece of code
// that changes with the scroll. The counts are real: 16 lines of WordPress, 8 of Pollora (imports included).
import Chapter from './Chapter.astro';
import { php } from '../lib/highlight';

type Kind = 'glue' | 'keep';
// WordPress line, its kind, and for a line that carries a decision, what it becomes in Pollora
const lines: { wp: string; kind: Kind; po?: string; lab?: boolean }[] = [
	{ wp: 'function register_book_post_type() {', kind: 'glue' },
	{ wp: "    register_post_type('book', [", kind: 'keep', po: "#[PostType('book')]" },
	{ wp: "        'labels' => [", kind: 'glue', lab: true },
	{ wp: "            'name'          => 'Books',", kind: 'glue', lab: true },
	{ wp: "            'singular_name' => 'Book',", kind: 'glue', lab: true },
	{ wp: "            'add_new'       => 'Add New Book',", kind: 'glue', lab: true },
	{ wp: "            'edit_item'     => 'Edit Book',", kind: 'glue', lab: true },
	{ wp: "            'view_item'     => 'View Book',", kind: 'glue', lab: true },
	{ wp: '        ],', kind: 'glue', lab: true },
	{ wp: "        'public'       => true,", kind: 'keep', po: '#[PublicPostType]' },
	{ wp: "        'has_archive'  => true,", kind: 'keep', po: '#[HasArchive]' },
	{ wp: "        'show_in_rest' => true,", kind: 'keep', po: '#[ShowInRest]' },
	{ wp: "        'supports'     => ['title', 'editor', 'thumbnail'],", kind: 'keep', po: "#[Supports(['title', 'editor', 'thumbnail'])]" },
	{ wp: '    ]);', kind: 'glue' },
	{ wp: '}', kind: 'glue' },
	{ wp: "add_action('init', 'register_book_post_type');", kind: 'glue' },
];

const pollora = `use Pollora\\Attributes\\PostType;
use Pollora\\Attributes\\PostType\\{HasArchive, PublicPostType, ShowInRest, Supports};

#[PostType('book')]
#[PublicPostType]
#[HasArchive]
#[ShowInRest]
#[Supports(['title', 'editor', 'thumbnail'])]
class Book {}`;

const steps = [
	{
		text: 'The same post type, written for WordPress and written for Pollora: sixteen lines against eight, imports included. Most of the WordPress version carries no decision. Pollora generates the labels from the class name and finds the class on its own: no function, no add_action. What stays is what you decided.',
		code: php(pollora),
	},
];
const { order } = Astro.props;
---

<Chapter
	id="difference"
	order={order}
	len={1.25}
	kicker="The difference, line by line"
	title='Watch what <span class="text-gradient">disappears.</span>'
	intro="Watch the same post type lose everything that was only glue."
	steps={steps}
	glow="var(--color-pollora-amber)"
>
	<div class="pdf-vars pin-panel pdf-panel">
		<div class="pdf-in">
			<div class="pdf-bar">
				<span class="pdf-file"><span class="pdf-file-wp">functions.php</span><span class="pdf-file-po">Book.php</span></span>
				<span class="pdf-count"><b class="pdf-n-wp">16 lines</b><b class="pdf-n-po">8 lines</b></span>
			</div>
			<div class="pdf-code">
				<div class="pdf-add pdf-add-top"><span class="token-keyword">use</span> Pollora\Attributes\PostType;</div>
				<div class="pdf-add pdf-add-top"><span class="token-keyword">use</span> Pollora\Attributes\PostType\&#123;…&#125;;</div>
				{lines.map((l) => (
					<div class:list={['pdf-line', l.kind === 'glue' ? 'pdf-glue' : 'pdf-keep', { 'pdf-lab': l.lab }]}>
						<span class="pdf-wp" set:html={php(l.wp)} />
						{l.po && <span class="pdf-po" set:html={php(l.po)} />}
					</div>
				))}
				<div class="pdf-add pdf-add-end"><span class="token-keyword">class</span> <span class="token-class">Book</span> &#123;&#125;</div>
			</div>
			<p class="pdf-legend"><span class="pdf-k-glue">glue</span><span class="pdf-k-keep">a decision</span></p>
		</div>
	</div>
</Chapter>

<style>
	.pdf-vars {
		--g: clamp(0, (var(--p) - 0.08) / 0.16, 1);
		--c: clamp(0, (var(--p) - 0.3) / 0.25, 1);
		--m: clamp(0, (var(--p) - 0.62) / 0.25, 1);
		container-type: inline-size;
		aspect-ratio: auto;
	}
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.pdf-vars { container-type: size; }
		}
	}
	.pdf-in {
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 2.4cqw;
		font: 500 max(9px, 2.1cqw) / 1.7 var(--font-code);
	}
	.pdf-bar { display: flex; justify-content: space-between; align-items: center; padding: 0 1cqw; color: color-mix(in oklch, var(--color-paper) 80%, transparent); }
	.pdf-file, .pdf-count { display: grid; }
	.pdf-file > *, .pdf-count > * { grid-area: 1 / 1; }
	.pdf-count { justify-items: end; }
	.pdf-count b { font-size: 1.5em; font-weight: 700; }
	.pdf-file-wp, .pdf-n-wp { opacity: calc(1 - clamp(0, var(--m) * 3, 1)); color: var(--color-pollora-amber); }
	.pdf-file-po, .pdf-n-po { opacity: clamp(0, var(--m) * 3 - 2, 1); color: var(--color-pollora-teal); }

	.pdf-code {
		padding: 2.4cqw 3cqw;
		border-radius: 1.6cqw;
		background: var(--color-code-surface);
		outline: 1px solid color-mix(in oklch, var(--color-paper) 16%, transparent);
	}
	.pdf-wp, .pdf-po, .pdf-add { white-space: pre-wrap; overflow-wrap: anywhere; }
	.pdf-line { display: grid; --lh: 1.7em; }
	.pdf-wp, .pdf-po { grid-area: 1 / 1; }

	/* the glue is tinted, then folds away */
	.pdf-glue {
		height: calc((1 - var(--c)) * var(--lh));
		overflow: hidden;
		opacity: calc(1 - var(--c) * 1.3);
		background: color-mix(in oklch, var(--color-pollora-amber) calc(var(--g) * 22%), transparent);
	}
	/* a line that carries a decision is marked, then becomes its attribute */
	.pdf-keep { box-shadow: inset 0.6cqw 0 0 color-mix(in oklch, var(--color-pollora-teal) calc(var(--g) * 100%), transparent); padding-left: 1.4cqw; }
	.pdf-keep .pdf-wp { opacity: calc(1 - clamp(0, var(--m) * 2.4, 1)); }
	.pdf-keep .pdf-po { opacity: clamp(0, var(--m) * 2.4 - 1, 1); translate: calc((1 - var(--m)) * 4cqw) 0; }

	/* what the Pollora version adds: the imports and the class */
	.pdf-add { height: calc(var(--m) * 1.7em); overflow: hidden; opacity: var(--m); }

	.pdf-legend { display: flex; gap: 3cqw; margin: 0; padding: 0 1cqw; font-size: 0.9em; font-family: var(--font-body); opacity: calc(var(--g) * (1 - var(--m))); }
	.pdf-legend span::before { content: ''; display: inline-block; width: 1.8cqw; height: 1.8cqw; margin-right: 1.2cqw; border-radius: 50%; vertical-align: -0.1em; }
	.pdf-k-glue { color: color-mix(in oklch, var(--color-paper) 85%, transparent); }
	.pdf-k-glue::before { background: var(--color-pollora-amber); }
	.pdf-k-keep { color: color-mix(in oklch, var(--color-paper) 85%, transparent); }
	.pdf-k-keep::before { background: var(--color-pollora-teal); }
</style>
