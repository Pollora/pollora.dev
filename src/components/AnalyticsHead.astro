---
/**
 * Google Tag Manager with Consent Mode v2. Goes in <head>; ConsentBanner goes in <body>.
 *
 * Nothing is stored before the visitor answers: consent defaults to "denied",
 * and only analytics_storage is ever granted (no ads on this site). The choice is
 * kept in localStorage for 13 months, the CNIL maximum. Any element with
 * [data-consent-open] reopens the banner so visitors can change their mind.
 *
 * Site events go to the dataLayer and GTM forwards them to GA4:
 * cta_click, copy_code, search, tour_video_play, docs_feedback. GTM only forwards these
 * five names, with cta_name, cta_location, link_url, code_language and search_term:
 * a new conversion is one of them with its own parameters, not a new event name.
 *
 * cta_click: [data-cta="Name"] elements; links into the docs and to /features/ from the
 * pages outside the docs; links to Pollora's GitHub and X, and to AmphiBee, from anywhere.
 * copy_code: code blocks of the docs, the install command of the homepage, and the
 * "Copy page" menu (page-markdown, mcp-command).
 */
const GTM_ID = 'GTM-59HN2M7Z';
---

<script is:inline define:vars={{ GTM_ID }}>
	(function () {
		var KEY = 'pollora-consent';
		var MAX_AGE = 1000 * 60 * 60 * 24 * 395; // 13 months
		window.dataLayer = window.dataLayer || [];
		function gtag() { window.dataLayer.push(arguments); }

		gtag('consent', 'default', {
			ad_storage: 'denied',
			ad_user_data: 'denied',
			ad_personalization: 'denied',
			analytics_storage: 'denied',
			wait_for_update: 500,
		});

		var stored = null;
		try {
			var raw = JSON.parse(localStorage.getItem(KEY) || 'null');
			if (raw && Date.now() - raw.at < MAX_AGE) stored = raw.value;
		} catch (e) {}
		if (stored === 'granted') gtag('consent', 'update', { analytics_storage: 'granted' });

		// Content group: "Home", "Docs / Routing", …
		var sections = {
			'getting-started': 'Getting Started', 'core-concepts': 'Core Concepts', routing: 'Routing',
			content: 'Content', hooks: 'Hooks & Events', theming: 'Theming', blocks: 'Blocks',
			advanced: 'Advanced', nectar: 'Nectar AI', guides: 'Guides',
		};
		var pages = { features: 'Features', blog: 'Blog', changelog: 'Changelog', press: 'Press', why: 'About', compare: 'About', faq: 'About' };
		var first = location.pathname.split('/')[1] || '';
		var group = first === '' ? 'Home' : sections[first] ? 'Docs / ' + sections[first] : pages[first] || 'Other';
		if (/^404\b/.test(document.title)) group = 'Not found';
		window.dataLayer.push({ content_group: group });

		// Events recorded on a click that left the previous page (see below): sent now,
		// since GA4 batches hits and loses those queued right before a navigation.
		try {
			var pending = JSON.parse(sessionStorage.getItem('pollora-pending-event') || 'null');
			sessionStorage.removeItem('pollora-pending-event');
			if (pending && pending.event) window.dataLayer.push(pending);
		} catch (e) {}

		window.polloraConsent = {
			stored: stored,
			set: function (value) {
				try { localStorage.setItem(KEY, JSON.stringify({ value: value, at: Date.now() })); } catch (e) {}
				gtag('consent', 'update', { analytics_storage: value });
				this.stored = value;
			},
		};

		// GTM loads once the page is up, so its scripts do not compete with the first render.
		// Events pushed before then wait in the dataLayer and are sent when it arrives.
		function loadGtm() {
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', GTM_ID);
		}
		function whenIdle() {
			if ('requestIdleCallback' in window) requestIdleCallback(loadGtm, { timeout: 3000 });
			else setTimeout(loadGtm, 1500);
		}
		if (document.readyState === 'complete') whenIdle();
		else window.addEventListener('load', whenIdle, { once: true });
	})();
</script>

<script is:inline>
	(function () {
		var push = function (data) { window.dataLayer.push(data); };

		function location_of(el) {
			if (el.closest('nav, header')) return 'nav';
			if (el.closest('footer')) return 'footer';
			var section = el.closest('section');
			var heading = section && section.querySelector('h1, h2');
			return heading ? (heading.innerText || heading.textContent).trim().replace(/\s+/g, ' ').slice(0, 60) : 'page';
		}

		document.addEventListener('click', function (e) {
			var target = e.target instanceof Element ? e.target : null;
			if (!target) return;

			// Explicit events: <button data-track="tour_video_play">
			var tracked = target.closest('[data-track]');
			if (tracked) push({ event: tracked.getAttribute('data-track'), link_url: tracked.getAttribute('href') || undefined });

			// Copy buttons of code blocks
			var copy = target.closest('.expressive-code .copy button');
			if (copy) {
				var pre = copy.closest('figure') && copy.closest('figure').querySelector('pre');
				push({ event: 'copy_code', code_language: (pre && pre.getAttribute('data-language')) || 'plain' });
				return;
			}

			// Conversions: explicit [data-cta], docs and features links on the pages outside the docs, outbound links
			var marketing = document.body && document.body.hasAttribute('data-site');
			var outbound = { 'github.com/Pollora': 'GitHub', 'x.com/PolloraWP': 'X', 'amphibee.fr': 'AmphiBee' };
			var link = target.closest('[data-cta], a[href]');
			if (!link) return;
			var href = link.getAttribute('href') || '';
			var name = link.getAttribute('data-cta');
			if (!name) {
				for (var key in outbound) if (href.indexOf(key) !== -1) name = outbound[key];
			}
			if (!name && marketing && /^\/(getting-started|features)\//.test(href)) {
				name = link.textContent.trim().replace(/\s+/g, ' ').replace(/\s*→$/, '').slice(0, 60);
			}
			if (!name) return;
			var data = { event: 'cta_click', cta_name: name, cta_location: location_of(link), link_url: href || undefined };
			// Same-tab navigation: hand the event to the next page
			var leaves = link.tagName === 'A' && /^(\/(?!\/)|https?:)/.test(href);
			var newTab = e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1 || link.target === '_blank';
			if (!leaves || newTab) push(data);
			else try { sessionStorage.setItem('pollora-pending-event', JSON.stringify(data)); } catch (err) { push(data); }
		}, true);

		// Docs search (Pagefind): one event per settled query
		var timer, last = '';
		document.addEventListener('input', function (e) {
			var input = e.target;
			if (!(input instanceof HTMLInputElement) || !input.closest('site-search')) return;
			clearTimeout(timer);
			timer = setTimeout(function () {
				var term = input.value.trim().toLowerCase();
				if (term.length >= 3 && term !== last) {
					last = term;
					push({ event: 'search', search_term: term });
				}
			}, 1200);
		});
	})();
</script>
